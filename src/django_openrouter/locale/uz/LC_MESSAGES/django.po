msgstr "Foydalanish profili"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Katalogni OpenRouter bilan sinxronlash"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Sinxronizatsiya tugadi: yaratildi %(created)s, yangilandi %(updated)s, "
"faolsizlantirildi %(deactivated)s (%(total)s masofaviy)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Foydalanish profiliga biriktirish…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Modellarni foydalanish profiliga biriktirish"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s allaqachon zanjirda"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s faol emas"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s bepul emas (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "%(count)s ta model profilga qo'shildi: “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Profilga hech qanday model qo'shilmadi: “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "O'tkazib yuborildi: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Foydalanish profili ko'rsatilmagan va default_profile o'rnatilmagan."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "%(name)r foydalanish profili topilmadi yoki faol emas."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Noma'lum model: %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "%(name)r profilida hech qanday model sozlanmagan."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "%(name)r profili uchun ruxsat etilgan modellar qolmadi."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "django-openrouter MVP da oqim rejimi (streaming) amalga oshirilmagan."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter admin sozlamalarida o'chirilgan."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "OpenRouter API kaliti sozlanmagan."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Barcha modellar ishlamadi, aniq xato ko'rsatilmagan."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter HTTP %(status)s qaytardi: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend LOG_BACKENDS yozuvida 'URL' talab qiladi (masalan, http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: noto'g'ri %(label)s identifikatori %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS yozuv lug'atida 'BACKEND' kaliti talab qilinadi."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS yozuvlari satr yoki lug'at bo'lishi kerak, olingan: %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Log backend %(path)r import qilib bo'lmadi: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r — LogBackend subclassi emas."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] ro'yxat bo'lishi kerak."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "GET /api/v1/models so'rovini yuborish va mahalliy OpenRouter katalogini yangilash."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Shu ishga oid API kalitini almashtirish."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"yaratildi=%(created)s yangilandi=%(updated)s faolsizlantirildi=%(deactivated)s "
"masofaviy=%(total)s"

#: models.py:45
