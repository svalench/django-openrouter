msgstr "Saqlangan API kalitni tozalash"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Kalit shifrlangan holda saqlangan. Saqlab qolish uchun bo'sh qoldiring yoki "
"almashtirish uchun yangi kalit kiriting. Saqlangan qiymatni ko'rib bo'lmaydi."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Bir marta kiritiladi, shifrlangan holda saqlanadi va qayta ko'rib bo'lmaydi. "
"OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] dan foydalanish uchun bo'sh qoldiring."

#: admin.py:216
msgid "API key status"
msgstr "API kalit holati"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Saqlangan (shifrlangan, ko'rinmaydi)"

#: admin.py:220
msgid "Not set"
msgstr "O'rnatilmagan"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Zaxira model faol bo'lishi kerak."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Zanjirdagi modellar faol bo'lishi kerak."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models faqat bepul modellarga ruxsat beradi."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Har bir model faqat bir marta qatnashishi mumkin."

#: admin.py:293
msgid "Model"
msgstr "Model"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modellar (ustuvorlik tartibida)"

