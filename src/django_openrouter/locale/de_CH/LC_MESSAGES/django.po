#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend erfordert 'URL' im LOG_BACKENDS-Eintrag (z. B. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: ungültiger %(label)s-Bezeichner %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Der LOG_BACKENDS-Eintrag-Dict erfordert einen 'BACKEND'-Schlüssel."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"LOG_BACKENDS-Einträge müssen Strings oder Dicts sein, erhalten: %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Log-Backend %(path)r kann nicht importiert werden: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r ist keine LogBackend-Unterklasse."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] muss eine Liste sein."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr ""
"Ruft GET /api/v1/models ab und führt Upsert im lokalen OpenRouter-Katalog "
"durch."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "API-Schlüssel für diesen Lauf überschreiben."

