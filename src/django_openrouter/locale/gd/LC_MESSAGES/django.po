msgstr "le only_free_models, chan eil modailean tèarainte an-asgaidh a-mhàin ceadaichte."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr "Fàg bàn e gus OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] a chleachdadh."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "Ùine-ri crìochnachaidh HTTP ann an diogan."

