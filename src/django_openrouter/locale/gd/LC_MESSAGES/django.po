#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Prìs"

#: admin.py:85
msgid "Free"
msgstr "An-asgaidh"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Saor (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Meadhanach ($1–$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Daor (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Luaths"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Luath (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Meadhanach (400–1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Slaodach (>= 1200 ms)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Uaireasbhaid neo-aithnichte"

#: admin.py:136
msgid "API key"
msgstr "Iuchair API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Falamhaich an iuchair API a chaidh a stòradh"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Tha iuchair air a stòradh air dòigh chrioptaichte. Fàg bàn e gus a chumail, no cuir a-steach iuchair ùr gus a "
"chur an àite. Cha ghabh an luach stòrailte a shealltainn."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Cuir a-steach aon turas, thèid a stòradh air dòigh chrioptaichte, agus cha ghabh a shealltainn a-rithist. Fàg bàn e gus "
"OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] a chleachdadh."

#: admin.py:216
msgid "API key status"
msgstr "Staid na h-iuchrach API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Stòrailte (crioptaichte, gun fhaicinn)"

#: admin.py:220
msgid "Not set"
msgstr "Gun shuidheachadh"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Feumaidh am modail tèarainte a bhith gnìomhach."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Feumaidh na modailean san t-slabhraidh a bhith gnìomhach."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "le only_free_models, chan eil modailean an-asgaidh a-mhàin ceadaichte."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Chan fhaod modail sam bith nochdadh ach aon turas."

#: admin.py:293
msgid "Model"
msgstr "Modail"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modailean (òrdugh prìomhachais)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Pròifìl chleachdaidh"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Sioncronaich an catalogue le OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Sioncronachadh deiseil: %(created)s cruthachaichte, %(updated)s air ùrachadh, %(deactivated)s air "
"neo-ghnìomhachadh (%(total)s cèin)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Sònraich do phròifìl chleachdaidh…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Sònraich modailean do phròifìl chleachdaidh"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s mu thràth san t-slabhraidh"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s neo-ghnìomhach"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s nach eil an-asgaidh (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Chaidh %(count)s mhodail(ean) a chur ri pròifìl “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Cha deach modail sam bith a chur ri pròifìl “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Air leum thairis: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Cha deach pròifìl chleachdaidh a shònrachadh agus chan eil default_profile air a shuidheachadh."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Chan eil pròifìl chleachdaidh %(name)r ann no tha i neo-ghnìomhach."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Modail neo-aithnichte %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Chan eil modailean air an rèiteachadh airson pròifìl %(name)r."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Chan eil modailean ceadaichte air fhàgail airson pròifìl %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Chan eil streaming air a chur an gnìomh ann am MVP django-openrouter."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "Tha OpenRouter à comas ann an roghainnean na rianachd."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Chan eil iuchair API OpenRouter air a rèiteachadh."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Dh'fhàillig gach modail gun mhearachd shònraichte."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "Thill OpenRouter HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"Feumar 'URL' ann an inntrig LOG_BACKENDS le ClickHouseBackend (m.e. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: aithneachair %(label)s neo-dhligheach %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Feumar iuchair 'BACKEND' ann an inntrig LOG_BACKENDS (dict)."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Feumar inntrigean LOG_BACKENDS a bhith nan sreangan no dicts, fhuaradh %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Cha ghabh backend loga %(path)r ion-phortadh: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "Chan eil %(path)r na bhùclas-ìosal LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "Feumar OPENROUTER['LOG_BACKENDS'] a bhith na liosta."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Faigh GET /api/v1/models agus ùraich an catalogue OpenRouter ionadail (upsert)."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Sgrìobh thairis na h-iuchair API airson an ruith seo."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"cruthachaichte=%(created)s ùrachadh=%(updated)s neo-ghnìomhachadh=%(deactivated)s "
"cèin=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "ID modail OpenRouter, m.e. anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "Prìsean gach tòcan: prompt, completion, iarrtas/dealbh roghainneil."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "Prìs prompt gach tòcan on chatalogue, airson seòrsachadh na rianachd."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "Prìs completion gach tòcan on chatalogue, airson seòrsachadh na rianachd."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "TTFT p50 airson an endpoint as fheàrr, ann am mille-dhiogan."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "Dèanadas p50 (tok/s) airson an endpoint as fheàrr — luchd."

