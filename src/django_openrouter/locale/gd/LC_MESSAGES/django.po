msgid "Usage profiles"
msgstr "Pròifilean chleachdaidh"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Feumar teòthachd a bhith eadar 0 agus 2."

#: models.py:163
msgid "Primary model must be active."
msgstr "Feumaidh am prìomh mhodail a bhith gnìomhach."

#: models.py:166
