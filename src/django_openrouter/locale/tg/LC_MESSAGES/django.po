msgstr "Маҳдудияти рӯзонаи дархост (%(limit)s) барои профили %(name)r гузашта шуд."

#: rules.py:47
#, python-format
msgid "Monthly request limit (%(limit)s) exceeded for profile %(name)r."
msgstr "Маҳдудияти моҳонаи дархост (%(limit)s) барои профили %(name)r гузашта шуд."

#: rules.py:54
#, python-format
msgid "Daily budget (%(budget)s USD) exceeded for profile %(name)r."
msgstr "Буҷети рӯзона (%(budget)s USD) барои профили %(name)r гузашта шуд."

#: rules.py:61
#, python-format
msgid "Monthly budget (%(budget)s USD) exceeded for profile %(name)r."
msgstr "Буҷети моҳона (%(budget)s USD) барои профили %(name)r гузашта шуд."

#: rules.py:69
#, python-format
msgid "Model %(model_id)r is disabled."
msgstr "Модели %(model_id)r хомӯш аст."

#: rules.py:72
#, python-format
msgid "Profile %(name)r allows only free models; %(model_id)r is not free."
msgstr "Профили %(name)r танҳо моделҳои ройгонро иҷозат медиҳад; %(model_id)r ройгон нест."

#: sync.py:242
