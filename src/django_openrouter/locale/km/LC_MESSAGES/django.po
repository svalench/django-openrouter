msgstr "ម៉ូដែល %(model_id)r ត្រូវបានបិទ។"

#: rules.py:72
#, python-format
msgid "Profile %(name)r allows only free models; %(model_id)r is not free."
msgstr "ទម្រង់ %(name)r អនុញ្ញាតតែម៉ូដែលឥតគិតថ្លៃ។ %(model_id)r មិនឥតគិតថ្លៃ។"

