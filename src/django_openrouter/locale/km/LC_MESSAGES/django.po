msgstr "Temperature ត្រូវតែស្ថិតរវាង 0 និង 2។"

#: models.py:163
msgid "Primary model must be active."
msgstr "ម៉ូដែលចម្បងត្រូវតែសកម្ម។"

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "only_free_models ត្រូវការម៉ូដែលចម្បងឥតគិតថ្លៃ។"

#: models.py:263
msgid "Profile model"
msgstr "ម៉ូដែលទម្រង់"

#: models.py:264
msgid "Profile models"
msgstr "ម៉ូដែលទម្រង់"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models អនុញ្ញាតតែម៉ូដែលបម្រុងឥតគិតថ្លៃ។"

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr "ទុកទំនេរ ដើម្បីប្រើ OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']។"

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "ពេលវេលាផុតកំណត់ HTTP ជាវិនាទី។"

