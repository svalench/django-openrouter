#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr "កោសិកាបិទសកល។ ពេលបិទ ការហៅ chat() ទាំងអស់បរាជ័យ។"

#: models.py:312 models.py:313 models.py:316
msgid "OpenRouter settings"
msgstr "ការកំណត់ OpenRouter"

#: models.py:360
msgid "Request log"
msgstr "កំណត់ហេតុសំណើ"

#: models.py:361
msgid "Request logs"
msgstr "កំណត់ហេតុសំណើ"

#: models.py:366
msgid "Can view usage logs"
msgstr "អាចមើលកំណត់ហេតុប្រើប្រាស់"

#: rules.py:25
#, python-format
msgid "Usage profile %(name)r is disabled."
msgstr "ទម្រង់ប្រើប្រាស់ %(name)r ត្រូវបានបិទ។"

#: rules.py:39
#, python-format
msgid "Daily request limit (%(limit)s) exceeded for profile %(name)r."
msgstr "លើសដែនកំណត់សំណើប្រចាំថ្ងៃ (%(limit)s) សម្រាប់ទម្រង់ %(name)r។"

#: rules.py:47
#, python-format
msgid "Monthly request limit (%(limit)s) exceeded for profile %(name)r."
msgstr "លើសដែនកំណត់សំណើប្រចាំខែ (%(limit)s) សម្រាប់ទម្រង់ %(name)r។"

#: rules.py:54
#, python-format
msgid "Daily budget (%(budget)s USD) exceeded for profile %(name)r."
msgstr "លើសថវិកាប្រចាំថ្ងៃ (%(budget)s USD) សម្រាប់ទម្រង់ %(name)r។"

#: rules.py:61
#, python-format
msgid "Monthly budget (%(budget)s USD) exceeded for profile %(name)r."
msgstr "លើសថវិកាប្រចាំខែ (%(budget)s USD) សម្រាប់ទម្រង់ %(name)r។"

#: rules.py:69
#, python-format
