#: admin.py:136
msgid "API key"
msgstr "API-ŝlosilo"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Forviŝ konservitan API-ŝlosilon"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Ŝlosilo estas konservita ĉifrite. Lasu malplenan por ĝin konservi, aŭ enigu "
"novan ŝlosilon por anstataŭi ĝin. La konservita valoro ne estas videbla."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Enigita unufoje, konservita ĉifrite kaj ne plu videbla. Lasu malplenan por "
"uzi OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Stato de API-ŝlosilo"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Konservita (ĉifrite, ne videbla)"

#: admin.py:220
msgid "Not set"
msgstr "Ne agordita"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Rezerva modelo devas esti aktiva."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Modeloj en la ĉeno devas esti aktivaj."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models permesas nur senpagajn modelojn."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Ĉiu modelo povas aperi nur unufoje."

#: admin.py:293
msgid "Model"
msgstr "Modelo"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modeloj (laŭ prioritata ordo)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Uzprofilo"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Sinkronigi katalogon kun OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Sinkronigo finita: %(created)s kreitaj, %(updated)s ĝisdatigitaj, "
"%(deactivated)s malaktivigitaj (%(total)s foraj)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Atribui al uzprofilo…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Atribui modelojn al uzprofilo"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s jam en la ĉeno"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s neaktivaj"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s ne senpagaj (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Aldonis %(count)s modelo(j)n al profilo “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Neniuj modeloj estis aldonitaj al profilo “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Preterpasitaj: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Neniu uzprofilo specifita kaj default_profile ne estas agordita."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Uzprofilo %(name)r ne troviĝas aŭ ne estas aktiva."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Nekonata modelo %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Profilo %(name)r havas neniujn agorditajn modelojn."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Restas neniuj permesitaj modeloj por profilo %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Datumfluo (streaming) ne estas realigita en django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter estas malŝaltita en la administra agordo."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "API-ŝlosilo de OpenRouter ne estas agordita."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Ĉiuj modeloj malsukcesis sen specifa eraro."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter redonas HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend postulas 'URL' en la LOG_BACKENDS-ero (ekz. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: nevalida %(label)s-identigilo %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "La vortara ero de LOG_BACKENDS postulas la ŝlosilon 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "La eroj de LOG_BACKENDS devas esti ĉenoj aŭ vortaroj, ricevita %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Ne eblis importi protokolbackend %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r ne estas subklaso de LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] devas esti listo."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Alvenigi GET /api/v1/models kaj ĝisdatigi la lokan OpenRouter-katalogon."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Anstataŭigi API-ŝlosilon por ĉi tiu rulo."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"kreitaj=%(created)s ĝisdatigitaj=%(updated)s malaktivigitaj=%(deactivated)s "
"foraj=%(total)s"

#: models.py:45
