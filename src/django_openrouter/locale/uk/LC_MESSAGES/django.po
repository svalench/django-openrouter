#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Ціна"

#: admin.py:85
msgid "Free"
msgstr "Безкоштовні"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Дешеві (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Середні ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Дорогі (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Швидкість"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Швидкі (< 400 мс)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Середні (400-1200 мс)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Повільні (>= 1200 мс)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Невідома затримка"

#: admin.py:136
msgid "API key"
msgstr "Ключ API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Очистити збережений ключ API"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Ключ збережено в зашифрованому вигляді. Залиште поле порожнім, щоб зберегти "
"його, або введіть новий ключ для заміни. Збережене значення переглянути "
"неможливо."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Вводиться один раз, зберігається в зашифрованому вигляді та не може бути "
"переглянутий повторно. Залиште порожнім, щоб використовувати "
"OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Статус ключа API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Збережено (зашифровано, не відображається)"

#: admin.py:220
msgid "Not set"
msgstr "Не встановлено"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Резервна модель має бути активною."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Моделі в ланцюжку мають бути активними."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models дозволяє лише безкоштовні моделі."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Кожна модель може з’являтися лише один раз."

#: admin.py:293
msgid "Model"
msgstr "Модель"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Моделі (за пріоритетом)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Профіль використання"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Синхронізувати каталог із OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Синхронізацію завершено: створено %(created)s, оновлено %(updated)s, "
"деактивовано %(deactivated)s (%(total)s віддалених)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Призначити профілю використання…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Призначити моделі профілю використання"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s уже в ланцюжку"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s неактивних"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s не безкоштовні (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Додано %(count)s моделей до профілю «%(profile)s»."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Жодну модель не додано до профілю «%(profile)s»."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Пропущено: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Профіль використання не вказано, а default_profile не встановлено."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Профіль використання %(name)r не знайдено або він неактивний."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Невідома модель %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Профіль %(name)r не має налаштованих моделей."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Для профілю %(name)r не залишилося дозволених моделей."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Потокову передачу (streaming) не реалізовано в django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter вимкнено в налаштуваннях адмінки."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Ключ API OpenRouter не налаштовано."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Усі моделі завершилися невдало без конкретної помилки."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter повернув HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend вимагає ключ 'URL' у записі LOG_BACKENDS (наприклад, "
"http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: недійсний ідентифікатор %(label)s %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Словник запису LOG_BACKENDS вимагає ключ 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Записи LOG_BACKENDS мають бути рядками або словниками, отримано %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Неможливо імпортувати бекенд журналювання %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r не є підкласом LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] має бути списком."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Отримати GET /api/v1/models і виконати upsert локального каталогу OpenRouter."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Перевизначити ключ API для цього запуску."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"

