msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "Ceny za token: prompt, completion, opcjonalnie żądanie/obraz."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "Cena promptu za token z katalogu, do sortowania w administracji."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "Cena completion za token z katalogu, do sortowania w administracji."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "p50 TTFT dla najlepszego endpointu, w milisekundach."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "p50 przepustowość (tok/s) dla najlepszego endpointu — obciążenie."

