msgstr ""
"Jeśli włączone, można używać tylko modeli z zerową ceną w katalogu."

#: models.py:149
msgid "Usage profiles"
msgstr "Profile użycia"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Temperatura musi być w zakresie od 0 do 2."

#: models.py:163
msgid "Primary model must be active."
msgstr "Model główny musi być aktywny."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "only_free_models wymaga darmowego modelu głównego."

#: models.py:263
msgid "Profile model"
msgstr "Model profilu"

#: models.py:264
msgid "Profile models"
msgstr "Modele profilu"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models zezwala tylko na darmowe modele zapasowe."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Pozostaw puste, aby użyć OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "Limit czasu HTTP w sekundach."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr ""
"Ponowne próby na model przy błędach transportu / 5xx przed przełączeniem na "
"model zapasowy."

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr ""
"Globalny wyłącznik. Gdy wyłączony, każde wywołanie chat() kończy się "
"niepowodzeniem."

