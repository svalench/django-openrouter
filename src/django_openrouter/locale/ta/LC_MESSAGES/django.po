msgstr "OpenRouter மாதிரி id, எ.கா. anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "டோக்கன் ஒன்றுக்கான விலைகள்: prompt, completion, விருப்ப request/image."

#: models.py:61
