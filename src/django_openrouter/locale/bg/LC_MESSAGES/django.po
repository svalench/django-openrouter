msgstr "Стабилен slug, използван в кода, напр. chat, translation."

#: models.py:116
msgid "First model in the chain (synced from the list)."
msgstr "Първи модел във веригата (синхронизиран от списъка)."

#: models.py:142
msgid "If enabled, only models with zero catalog price may be used."
msgstr ""
"Ако е включено, могат да се използват само модели с нулева цена в каталога."

#: models.py:149
msgid "Usage profiles"
msgstr "Профили на използване"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Temperature трябва да е между 0 и 2."

#: models.py:163
msgid "Primary model must be active."
msgstr "Основният модел трябва да е активен."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "only_free_models изисква безплатен основен модел."

#: models.py:263
msgid "Profile model"
msgstr "Модел на профил"

#: models.py:264
msgid "Profile models"
msgstr "Модели на профил"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models позволява само безплатни резервни модели."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Оставете празно, за да се използва OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "HTTP изчакване в секунди."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr ""
"Повторни опити на модел при транспортни грешки / 5xx преди преминаване към "
"резервен."

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr ""
"Глобален изключвател. Когато е изключен, всяко извикване на chat() се "
"проваля."

