#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Цена"

#: admin.py:85
msgid "Free"
msgstr "Безплатен"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Евтин (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Среден ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Скъп (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Скорост"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Бърз (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Среден (400-1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Бавен (>= 1200 ms)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Неизвестно забавяне"

#: admin.py:136
msgid "API key"
msgstr "API ключ"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Изчисти запазения API ключ"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Ключът е запазен шифрован. Оставете празно, за да го запазите, или въведете "
"нов ключ, за да го замените. Запазената стойност не може да бъде прегледана."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Въвежда се веднъж, запазва се шифрован и не може да бъде прегледан отново. "
"Оставете празно, за да се използва OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Статус на API ключа"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Запазен (шифрован, невидим)"

#: admin.py:220
msgid "Not set"
msgstr "Не е зададен"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Резервният модел трябва да е активен."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Моделите във веригата трябва да са активни."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models позволява само безплатни модели."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Всеки модел може да се появява само веднъж."

#: admin.py:293
msgid "Model"
msgstr "Модел"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Модели (по приоритет)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Профил на използване"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Синхронизирай каталога с OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Синхронизацията завърши: %(created)s създадени, %(updated)s обновени, "
"%(deactivated)s деактивирани (%(total)s отдалечени)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Присвояване към профил на използване…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Присвояване на модели към профил на използване"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s вече са във веригата"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s неактивни"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s не са безплатни (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Добавени %(count)s модел(а) към профила „%(profile)s“."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Не бяха добавени модели към профила „%(profile)s“."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Пропуснати: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr ""
"Не е посочен профил на използване и default_profile не е зададен."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Профилът на използване %(name)r не е намерен или не е активен."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Неизвестен модел %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Профилът %(name)r няма конфигурирани модели."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Не остават разрешени модели за профила %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Streaming не е реализиран в django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter е деактивиран в настройките на администрацията."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "API ключът за OpenRouter не е конфигуриран."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Всички модели се провалиха без конкретна грешка."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter върна HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend изисква 'URL' в записа LOG_BACKENDS (напр. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: невалиден идентификатор %(identifier)r за %(label)s."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Речникът в запис LOG_BACKENDS изисква ключ 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"Записите в LOG_BACKENDS трябва да са низове или речници, получен е %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Не може да се импортира бекенд за логове %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r не е наследник на LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] трябва да е списък."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr ""
"Изтегля GET /api/v1/models и обновява локалния каталог на OpenRouter."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Презаписва API ключа за това изпълнение."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"създадени=%(created)s обновени=%(updated)s деактивирани=%(deactivated)s "
"отдалечени=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "Идентификатор на модел в OpenRouter, напр. anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr ""
"Цени на токен: prompt, completion, както и по желание request/image."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "Цена на prompt за токен от каталога, за сортиране в администрацията."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr ""
"Цена на completion за токен от каталога, за сортиране в администрацията."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "p50 TTFT за най-добрия endpoint, в милисекунди."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "p50 пропускателна способност (tok/s) за най-добрия endpoint — натоварване."

