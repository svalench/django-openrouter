#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"ಸಿಂಕ್ ಪೂರ್ಣ: %(created)s ರಚಿಸಲಾಗಿದೆ, %(updated)s ನವೀಕರಿಸಲಾಗಿದೆ, "
"%(deactivated)s ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ (%(total)s ದೂರಸ್ಥ)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "ಬಳಕೆ ಪ್ರೊಫೈಲ್‌ಗೆ ನಿಯೋಜಿಸಿ…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "ಬಳಕೆ ಪ್ರೊಫೈಲ್‌ಗೆ ಮಾದರಿಗಳನ್ನು ನಿಯೋಜಿಸಿ"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s ಸರಣಿಯಲ್ಲಿ ಈಗಾಗಲೇ ಇವೆ"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s ನಿಷ್ಕ್ರಿಯ"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s ಉಚಿತವಲ್ಲ (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "“%(profile)s” ಪ್ರೊಫೈಲ್‌ಗೆ %(count)s ಮಾದರಿ(ಗಳು) ಸೇರಿಸಲಾಗಿವೆ."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "“%(profile)s” ಪ್ರೊಫೈಲ್‌ಗೆ ಯಾವುದೇ ಮಾದರಿಗಳನ್ನು ಸೇರಿಸಲಾಗಿಲ್ಲ."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "ಬಳಕೆ ಪ್ರೊಫೈಲ್ ನಿರ್ದಿಷ್ಟಪಡಿಸಲಾಗಿಲ್ಲ ಮತ್ತು default_profile ಹೊಂದಿಸಲಾಗಿಲ್ಲ."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "ಬಳಕೆ ಪ್ರೊಫೈಲ್ %(name)r ಕಂಡುಬಂದಿಲ್ಲ ಅಥವಾ ನಿಷ್ಕ್ರಿಯವಾಗಿದೆ."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "ಗೊತ್ತಿಲ್ಲದ ಮಾದರಿ %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "ಪ್ರೊಫೈಲ್ %(name)r ಗೆ ಯಾವುದೇ ಮಾದರಿಗಳನ್ನು ಸಂರಚಿಸಲಾಗಿಲ್ಲ."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "ಪ್ರೊಫೈಲ್ %(name)r ಗೆ ಯಾವುದೇ ಅನುಮತಿಸಲಾದ ಮಾದರಿಗಳು ಉಳಿದಿಲ್ಲ."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "django-openrouter MVP ನಲ್ಲಿ ಸ್ಟ್ರೀಮಿಂಗ್ ಜಾರಿಗೊಳಿಸಲಾಗಿಲ್ಲ."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter ಅನ್ನು ನಿರ್ವಹಣಾ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "OpenRouter API ಕೀಲಿ ಸಂರಚಿಸಲಾಗಿಲ್ಲ."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "ನಿರ್ದಿಷ್ಟ ದೋಷವಿಲ್ಲದೆ ಎಲ್ಲಾ ಮಾದರಿಗಳು ವಿಫಲಗೊಂಡಿವೆ."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter HTTP %(status)s ಹಿಂದಿರುಗಿಸಿದೆ: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend ಗೆ LOG_BACKENDS ನಮೂದಿನಲ್ಲಿ 'URL' ಬೇಕಾಗುತ್ತದೆ (ಉದಾ. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: ಅಮಾನ್ಯ %(label)s ಗುರುತು %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS ನಮೂದು dict ಗೆ 'BACKEND' ಕೀಲಿ ಬೇಕಾಗುತ್ತದೆ."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS ನಮೂದುಗಳು string ಅಥವಾ dict ಆಗಿರಬೇಕು, ಸಿಕ್ಕಿದ್ದು %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "ಲಾಗ್ ಬ್ಯಾಕೆಂಡ್ %(path)r ಅನ್ನು ಆಮದು ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r ಎಂಬುದು LogBackend ಉಪವರ್ಗವಲ್ಲ."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] ಪಟ್ಟಿ ಆಗಿರಬೇಕು."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "GET /api/v1/models ಅನ್ನು ಪಡೆದು ಸ್ಥಳೀಯ OpenRouter ಕ್ಯಾಟಲಾಗ್ ಅನ್ನು ಅಪ್‌ಸರ್ಟ್ ಮಾಡಿ."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "ಈ ಚಾಲನೆಗಾಗಿ API ಕೀಲಿಯನ್ನು override ಮಾಡಿ."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
