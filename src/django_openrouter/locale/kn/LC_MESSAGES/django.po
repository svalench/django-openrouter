#: admin.py:136
msgid "API key"
msgstr "API ಕೀಲಿ"

#: admin.py:145
msgid "Clear stored API key"
msgstr "ಸಂಗ್ರಹಿಸಿದ API ಕೀಲಿಯನ್ನು ತೆರವುಗೊಳಿಸಿ"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"ಕೀಲಿಯನ್ನು ಗೂಢಲಿಪೀಕರಣ ಮಾಡಿ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ. ಅದನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲು ಖಾಲಿ ಬಿಡಿ, ಅಥವಾ "
"ಬದಲಾಯಿಸಲು ಹೊಸ ಕೀಲಿಯನ್ನು ನಮೂದಿಸಿ. ಸಂಗ್ರಹಿಸಿದ ಮೌಲ್ಯವನ್ನು ನೋಡಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"ಒಮ್ಮೆ ನಮೂದಿಸಿ, ಗೂಢಲಿಪೀಕರಣ ಮಾಡಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ, ಮತ್ತೆ ನೋಡಲು ಸಾಧ್ಯವಿಲ್ಲ. "
"OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] ಬಳಸಲು ಖಾಲಿ ಬಿಡಿ."

#: admin.py:216
msgid "API key status"
msgstr "API ಕೀಲಿ ಸ್ಥಿತಿ"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "ಸಂಗ್ರಹಿಸಲಾಗಿದೆ (ಗೂಢಲಿಪೀಕರಣ, ಕಾಣದು)"

#: admin.py:220
msgid "Not set"
msgstr "ಹೊಂದಿಸಲಾಗಿಲ್ಲ"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "ಫಾಲ್‌ಬ್ಯಾಕ್ ಮಾದರಿ ಸಕ್ರಿಯವಾಗಿರಬೇಕು."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "ಸರಣಿಯಲ್ಲಿರುವ ಮಾದರಿಗಳು ಸಕ್ರಿಯವಾಗಿರಬೇಕು."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models ಉಚಿತ ಮಾದರಿಗಳಿಗೆ ಮಾತ್ರ ಅನುಮತಿಸುತ್ತದೆ."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "ಪ್ರತಿ ಮಾದರಿಯು ಒಮ್ಮೆ ಮಾತ್ರ ಕಾಣಿಸಿಕೊಳ್ಳಬಹುದು."

#: admin.py:293
msgid "Model"
msgstr "ಮಾದರಿ"

#: admin.py:294
msgid "Models (priority order)"
