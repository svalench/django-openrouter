msgstr "ಟೋಕನ್‌ಗೆ ಬೆಲೆಗಳು: prompt, completion, ಐಚ್ಛಿಕ request/image."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "ಕ್ಯಾಟಲಾಗ್‌ನಿಂದ ಟೋಕನ್‌ಗೆ prompt ಬೆಲೆ, ನಿರ್ವಹಣಾ ವಿಂಗಡಣೆಗಾಗಿ."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "ಕ್ಯಾಟಲಾಗ್‌ನಿಂದ ಟೋಕನ್‌ಗೆ completion ಬೆಲೆ, ನಿರ್ವಹಣಾ ವಿಂಗಡಣೆಗಾಗಿ."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "ಉತ್ತಮ endpoint ಗಾಗಿ p50 TTFT, ಮಿಲಿಸೆಕೆಂಡ್‌ಗಳಲ್ಲಿ."

#: models.py:78
