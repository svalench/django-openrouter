#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Agrim"

#: admin.py:85
msgid "Free"
msgstr "Baṭel"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Ur yelhi ara (< 1 $ / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Anammas (1-10 $ / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Yelhan (≥ 10 $ / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Azellal"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Aḥeṛṛi (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Anammas (400-1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Yumas (≥ 1200 ms)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Taneggalt tarussint"

#: admin.py:136
msgid "API key"
msgstr "Tasarut n API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Sfeḍ tasarut n API yettwasekles"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Tasarut yettwasekles s uwgelhen. Eǧǧ-itt d tilemnt akken ad tḥerzeḍ, neɣ "
"sekcem tasarut tamaynut akken ad t-tbeddleḍ. Azal yettwaseklen ur yezmir ad "
"yettwawali."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Yettusekcem yiwet n tikelt, yettwasekles s uwgelhen, ur yezmir ad yettwawali "
"tikelt nniḍen. Eǧǧ-itt d tilemnt akken tessemraḍ OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Addad n tasarut n API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Yettwasekles (iwegelhen, ur yettban ara)"

#: admin.py:220
msgid "Not set"
msgstr "Ur yettusbadew ara"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Taneɣruft n ufru ilaq ad teddud."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Tineɣrufin deg uzrar ilaq ad ddedunt."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models yeqbel kan tineɣrufin baṭelen."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Kull taneɣruft tezmer ad d-tban kan yiwet n tikelt."

#: admin.py:293
msgid "Model"
msgstr "Taneɣruft"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Tineɣrufin (s umizzwer)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Aɣerda n useqdec"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Mtawi katalog akked OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Asemselsi ifuk: %(created)s ttwarnant-d, %(updated)s ttwaleqqament, "
"%(deactivated)s ttwaddament (%(total)s anmeggag)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Sumer i uɣerda n useqdec…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Sumer tineɣrufin i uɣerda n useqdec"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s yellan deg uzrar"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s ur ddedun ara"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s mačči baṭelen (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "%(count)s taneɣruft(i) ttwaznant i uɣerda “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Ulac taneɣruft i yettwaznen i uɣerda “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Yettwaḍḥer: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Ulac aɣerda n useqdec i yemmalen, default_profile ur yettusbadew ara."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Aɣerda n useqdec %(name)r ulac-it neɣ ur yeddi ara."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Taneɣruft tarussint %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Aɣerda %(name)r ulac-it tineɣrufin yettwasbedden."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Ulac taneɣruft i yettwasiregen i uɣerda %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Asuddem (streaming) ur yettwarmed ara deg django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter yeffes deg iɣewwaṛen n unedbal."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Tasarut n API OpenRouter ur yettusbadew ara."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Akk tineɣrufin ffɣent war tuccḍa weḥden."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter yerra-d HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend yesra 'URL' deg ufeggag n LOG_BACKENDS (amedya http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: isem %(identifier)r n %(label)s d arameɣtu."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Afeggag n LOG_BACKENDS (dict) yesra tasarut 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Iferdisen n LOG_BACKENDS ilaq ad ilint d izralen neɣ d dicts, i "
"d-yettwaf %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "D awezɣi usider n log backend %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r ur d tafernatt n LogBackend ara."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] ilaq ad tili d tebdart."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Awi GET /api/v1/models rnu leqqem katalog n OpenRouter adigan."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Beddel tasarut n API i wexdem-agi."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "Asulay n taneɣruft OpenRouter, amedya anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "Igrawen i yal ajiṭun: prompt, completion, asuter/tugna d afrayan."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "Agrim n prompt i yal ajiṭun seg katalog, i usmizzwer deg unedbal."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "Agrim n completion i yal ajiṭun seg katalog, i usmizzwer deg unedbal."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "p50 n TTFT i temsa yelhan, deg milisekond."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "p50 n uselkem (tok/s) i temsa yelhan — ṣḍaṣ."

#: models.py:85
msgid "OpenRouter model"
msgstr "Taneɣruft OpenRouter"

#: models.py:86
#: templates/admin/django_openrouter/openroutermodel/assign_to_profile.html:7
msgid "OpenRouter models"
msgstr "Tineɣrufin OpenRouter"

#: models.py:108
msgid "Stable slug used in code, e.g. chat, translation."
msgstr "Slug ibeddlen yettuseqdac deg tengalt, amedya chat, asuğal."

#: models.py:116
msgid "First model in the chain (synced from the list)."
msgstr "Taneɣruft tamezwarut deg uzrar (yettwamedl s tebdart)."

#: models.py:142
msgid "If enabled, only models with zero catalog price may be used."
msgstr "Ma yermed, kan tineɣrufin ig wazal n katalog 0 zemren ad ttuseqdacent."

#: models.py:149
msgid "Usage profiles"
msgstr "Iɣerda n useqdec"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Temperature ilaq ad tili gar 0 aked 2."

#: models.py:163
msgid "Primary model must be active."
msgstr "Taneɣruft tamezwarut ilaq ad teddud."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "only_free_models yesra taneɣruft tamezwarut baṭel."

#: models.py:263
msgid "Profile model"
msgstr "Taneɣruft n uɣerda"

#: models.py:264
msgid "Profile models"
msgstr "Tineɣrufin n uɣerda"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models yeqbel kan tineɣrufin n ufru baṭelen."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr "Eǧǧ d tilemnt akken tessemraḍ OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "Anegzum HTTP deg tasinin."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr "Ales aɛraḍ i yal taneɣruft ɣef tuccḍiwin n uwezzu / 5xx send afru."

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr "Taqeffalt n useḥbes amatu. Ma tella d terr, yal asiwed n chat() ad "
"yexṣer."

#: models.py:312 models.py:313 models.py:316
msgid "OpenRouter settings"
msgstr "Iɣewwaṛen n OpenRouter"

#: models.py:360
msgid "Request log"
msgstr "Aɣmis n usuter"

#: models.py:361
msgid "Request logs"
msgstr "Iɣmisen n usuter"

#: models.py:366
msgid "Can view usage logs"
msgstr "Izemr ad iwali iɣmisen n useqdec"

