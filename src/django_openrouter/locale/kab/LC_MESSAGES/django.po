msgstr "Aɣerda n useqdec %(name)r yeffes."

#: rules.py:39
#, python-format
msgid "Daily request limit (%(limit)s) exceeded for profile %(name)r."
msgstr "Azal n wass (%(limit)s) yettwesɛed i uɣerda %(name)r."

#: rules.py:47
#, python-format
msgid "Monthly request limit (%(limit)s) exceeded for profile %(name)r."
