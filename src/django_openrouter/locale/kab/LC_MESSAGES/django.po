#: rules.py:54
#, python-format
msgid "Daily budget (%(budget)s USD) exceeded for profile %(name)r."
msgstr "Aɣerfa n wass (%(budget)s USD) yettwesɛed i uɣerda %(name)r."

#: rules.py:61
#, python-format
msgid "Monthly budget (%(budget)s USD) exceeded for profile %(name)r."
msgstr "Aɣerfa n waggur (%(budget)s USD) yettwesɛed i uɣerda %(name)r."

#: rules.py:69
#, python-format
msgid "Model %(model_id)r is disabled."
msgstr "Taneɣruft %(model_id)r tettwaẓdel."

#: rules.py:72
#, python-format
msgid "Profile %(name)r allows only free models; %(model_id)r is not free."
msgstr "Aɣerda %(name)r yeqbel kan tineɣrufin baṭelen; %(model_id)r mačči d "
"baṭel."

#: sync.py:242
msgid "Unexpected OpenRouter /models response."
msgstr "Tiririt OpenRouter /models taruḥt."

