#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Açar şifrələnmiş şəkildə saxlanılır. Saxlamaq üçün boş buraxın və ya əvəz "
"etmək üçün yeni açar daxil edin. Saxlanılmış dəyərə baxmaq mümkün deyil."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Bir dəfə daxil edilir, şifrələnmiş şəkildə saxlanılır və yenidən görünə "
"bilməz. OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] istifadə etmək "
"üçün boş buraxın."

#: admin.py:216
msgid "API key status"
msgstr "API açarı statusu"

