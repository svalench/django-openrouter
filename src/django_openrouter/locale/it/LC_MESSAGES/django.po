msgid "Unknown latency"
msgstr "Latenza sconosciuta"

#: admin.py:136
msgid "API key"
msgstr "Chiave API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Cancella la chiave API memorizzata"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Una chiave è memorizzata in forma cifrata. Lasciare vuoto per conservarla "
"oppure inserire una nuova chiave per sostituirla. Il valore memorizzato non "
"può essere visualizzato."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Inserita una sola volta, memorizzata in forma cifrata e non più "
"visualizzabile. Lasciare vuoto per usare OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Stato della chiave API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Memorizzata (cifrata, non visibile)"

#: admin.py:220
msgid "Not set"
msgstr "Non impostata"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Il modello di fallback deve essere attivo."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "I modelli della catena devono essere attivi."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models consente solo modelli gratuiti."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Ciascun modello può comparire una sola volta."

#: admin.py:293
msgid "Model"
msgstr "Modello"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modelli (ordine di priorità)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Profilo di utilizzo"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Sincronizza catalogo con OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Sincronizzazione completata: %(created)s creati, %(updated)s aggiornati, "
"%(deactivated)s disattivati (%(total)s remoti)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Assegna a profilo di utilizzo…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Assegna modelli a profilo di utilizzo"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s già presenti nella catena"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s inattivi"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s non gratuiti (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Aggiunti %(count)s modello/i al profilo “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Nessun modello aggiunto al profilo “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Saltati: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Nessun profilo di utilizzo specificato e default_profile non impostato."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Il profilo di utilizzo %(name)r non è stato trovato o è inattivo."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Modello sconosciuto %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Il profilo %(name)r non ha modelli configurati."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Nessun modello consentito rimasto per il profilo %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Lo streaming non è implementato nell'MVP di django-openrouter."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter è disabilitato nelle impostazioni di amministrazione."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "La chiave API di OpenRouter non è configurata."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Tutti i modelli hanno fallito senza un errore specifico."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter ha restituito HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend richiede 'URL' nella voce LOG_BACKENDS (ad es. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: identificativo %(label)s %(identifier)r non valido."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Il dizionario della voce LOG_BACKENDS richiede la chiave 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"Le voci di LOG_BACKENDS devono essere stringhe o dizionari, ricevuto "
"%(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Impossibile importare il backend di log %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r non è una sottoclasse di LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] deve essere una lista."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr ""
"Recupera GET /api/v1/models e aggiorna il catalogo OpenRouter locale."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Sovrascrivi la chiave API per questa esecuzione."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"

#: models.py:45
