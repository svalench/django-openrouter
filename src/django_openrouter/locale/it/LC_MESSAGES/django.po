#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Economico (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Medio ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Costoso (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Velocità"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Veloce (< 400 ms)"

