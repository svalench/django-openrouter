msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "It dict fan it LOG_BACKENDS-item fereasket in 'BACKEND'-kaai."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS-items moatte strings of dicts wêze, krige %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Kin log-backend %(path)r net ymportearje: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r is gjin LogBackend-subklasse."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] moat in list wêze."

