#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "هیچ مدلی به نمایهٔ «%(profile)s» افزوده نشد."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "رد شد: %(reasons)s."

