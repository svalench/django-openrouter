#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "نمایهٔ %(name)r هیچ مدل پیکربندی‌شده‌ای ندارد."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "هیچ مدل مجازی برای نمایهٔ %(name)r باقی نمانده است."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "استریمینگ در نسخهٔ MVP ‏django-openrouter پیاده‌سازی نشده است."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter در تنظیمات مدیر غیرفعال است."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "کلید API اوپن‌روتر پیکربندی نشده است."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "همهٔ مدل‌ها بدون خطای مشخصی ناموفق بودند."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter پاسخ HTTP %(status)s را برگرداند: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend به کلید «URL» در ورودی LOG_BACKENDS نیاز دارد (مثلاً "
"http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: شناسهٔ %(label)s نامعتبر %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "دیکشنری ورودی LOG_BACKENDS به کلید «BACKEND» نیاز دارد."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "ورودی‌های LOG_BACKENDS باید رشته یا دیکشنری باشند، %(type)s دریافت شد."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "بک‌اند ثبت‌رویداد %(path)r قابل واردکردن نیست: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r یک زیرکلاس LogBackend نیست."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] باید یک لیست باشد."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "واکشی GET /api/v1/models و upsert فهرست محلی OpenRouter."

#: management/commands/sync_models.py:18
