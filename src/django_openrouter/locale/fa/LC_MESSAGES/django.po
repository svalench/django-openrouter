msgid "No usage profile specified and default_profile is not set."
msgstr "نمایهٔ کاربردی مشخص نشده و default_profile تنظیم نیست."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "نمایهٔ کاربرد %(name)r یافت نشد یا غیرفعال است."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "مدل ناشناخته %(model_id)r."

