msgid "Models in the chain must be active."
msgstr "مدل‌های زنجیره باید فعال باشند."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models فقط مدل‌های رایگان را مجاز می‌کند."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "هر مدل فقط یک‌بار می‌تواند ظاهر شود."

