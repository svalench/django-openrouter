msgstr "همگام‌سازی فهرست با OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"همگام‌سازی کامل شد: %(created)s ساخته شد، %(updated)s به‌روزرسانی شد، "
"%(deactivated)s غیرفعال شد (%(total)s راه‌دور)."

