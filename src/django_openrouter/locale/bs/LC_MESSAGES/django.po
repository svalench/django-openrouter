#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Cijena"

#: admin.py:85
msgid "Free"
msgstr "Besplatno"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Jeftino (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Srednje ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Skupo (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Brzina"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Brzo (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Srednje (400-1200 ms)"

