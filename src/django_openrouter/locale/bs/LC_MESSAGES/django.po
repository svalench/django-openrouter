msgid "Unknown latency"
msgstr "Nepoznata latencija"

#: admin.py:136
msgid "API key"
msgstr "API ključ"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Ukloni pohranjeni API ključ"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Ključ je pohranjen šifrovano. Ostavite prazno da ga zadržite ili unesite "
"novi ključ da ga zamijenite. Pohranjena vrijednost se ne može prikazati."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Unosi se jednom, pohranjuje se šifrovano i ne može se ponovo prikazati. "
"Ostavite prazno za korištenje OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Status API ključa"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Pohranjen (šifrovano, nije vidljiv)"

#: admin.py:220
msgid "Not set"
msgstr "Nije postavljeno"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Fallback model mora biti aktivan."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Modeli u lancu moraju biti aktivni."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models dopušta samo besplatne modele."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Svaki model se može pojaviti samo jednom."

#: admin.py:293
msgid "Model"
msgstr "Model"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modeli (redoslijed prioriteta)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Profil korištenja"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Sinhronizuj katalog s OpenRouterom"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Sinhronizacija završena: %(created)s kreirano, %(updated)s ažurirano, "
"%(deactivated)s deaktivirano (%(total)s udaljeno)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Dodijeli profilu korištenja…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Dodijeli modele profilu korištenja"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s već u lancu"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s neaktivno"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s nije besplatno (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Dodano %(count)s model(a) u profil „%(profile)s“."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Nijedan model nije dodan u profil „%(profile)s“."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Preskočeno: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Profil korištenja nije naveden i default_profile nije postavljen."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Profil korištenja %(name)r nije pronađen ili je neaktivan."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Nepoznat model %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Profil %(name)r nema konfigurisanih modela."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Nema dozvoljenih modela za profil %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Streaming nije implementiran u django-openrouter MVP-u."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter je onemogućen u admin postavkama."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "OpenRouter API ključ nije konfigurisan."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Svi modeli su neuspjeli bez specifične greške."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter je vratio HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend zahtijeva 'URL' u stavci LOG_BACKENDS (npr. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: nevažeći %(label)s identifikator %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Rječnik stavke LOG_BACKENDS zahtijeva ključ 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Stavke LOG_BACKENDS moraju biti stringovi ili rječnici, dobijeno %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Nije moguće uvesti log backend %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r nije podklasa klase LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] mora biti lista."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Dohvati GET /api/v1/models i ažuriraj lokalni OpenRouter katalog."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Nadjačaj API ključ za ovaj pokret."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"kreirano=%(created)s ažurirano=%(updated)s deaktivirano=%(deactivated)s "
"udaljeno=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "ID OpenRouter modela, npr. anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "Cijene po tokenu: prompt, completion, opcionalno zahtjev/slika."

