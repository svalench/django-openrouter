msgstr "Cijena completiona po tokenu iz kataloga, za sortiranje u adminu."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "p50 TTFT za najbolji endpoint, u milisekundama."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "p50 protok (tok/s) za najbolji endpoint — opterećenje."

