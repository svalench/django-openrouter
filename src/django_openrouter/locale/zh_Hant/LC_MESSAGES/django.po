msgstr "鏈結中的第一個模型（從清單同步）。"

#: models.py:142
msgid "If enabled, only models with zero catalog price may be used."
msgstr "啟用後，僅可使用目錄價格為零的模型。"

#: models.py:149
msgid "Usage profiles"
msgstr "使用設定檔"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "溫度必須介於 0 和 2 之間。"

#: models.py:163
msgid "Primary model must be active."
msgstr "主要模型必須為啟用狀態。"

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "only_free_models 需要免費的主要模型。"

#: models.py:263
msgid "Profile model"
msgstr "設定檔模型"

#: models.py:264
msgid "Profile models"
msgstr "設定檔模型"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models 僅允許免費的備援模型。"

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr "留空則使用 OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']。"

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "HTTP 逾時時間（秒）。"

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr "fallback 之前，每個模型在傳輸 / 5xx 錯誤時的重試次數。"

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr "全域緊急開關。關閉時，每次 chat() 呼叫都會失敗。"

