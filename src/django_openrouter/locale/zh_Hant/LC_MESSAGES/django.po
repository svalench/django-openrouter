#: admin.py:78 admin.py:429
msgid "Price"
msgstr "價格"

#: admin.py:85
msgid "Free"
msgstr "免費"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "便宜（< $1 / 1M）"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "中等（$1-$10 / 1M）"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "昂貴（>= $10 / 1M）"

#: admin.py:98
msgid "Speed"
msgstr "速度"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "快速（< 400 毫秒）"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "中等（400-1200 毫秒）"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "緩慢（>= 1200 毫秒）"

#: admin.py:108
msgid "Unknown latency"
msgstr "延遲未知"

#: admin.py:136
msgid "API key"
msgstr "API 金鑰"

#: admin.py:145
msgid "Clear stored API key"
msgstr "清除已儲存的 API 金鑰"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"金鑰已加密儲存。留空可保留原金鑰，或輸入新金鑰以取代。已儲存的值無"
"法檢視。"

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"僅輸入一次，加密儲存後無法再次檢視。留空則使用 OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']。"

#: admin.py:216
msgid "API key status"
msgstr "API 金鑰狀態"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "已儲存（加密，不可見）"

#: admin.py:220
msgid "Not set"
msgstr "未設定"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "備援模型必須為啟用狀態。"

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "鏈結中的模型必須為啟用狀態。"

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models 僅允許免費模型。"

#: admin.py:273
msgid "Each model may appear only once."
msgstr "每個模型只能出現一次。"

#: admin.py:293
msgid "Model"
msgstr "模型"

#: admin.py:294
msgid "Models (priority order)"
msgstr "模型（優先順序）"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "使用設定檔"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "與 OpenRouter 同步目錄"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"同步完成：新增 %(created)s 個、更新 %(updated)s 個、停用 "
"%(deactivated)s 個（遠端共 %(total)s 個）。"

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "指派至使用設定檔…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "將模型指派至使用設定檔"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s 個已在鏈結中"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s 個未啟用"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s 個非免費（only_free_models）"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "已將 %(count)s 個模型加入設定檔「%(profile)s」。"

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "沒有模型被加入設定檔「%(profile)s」。"

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "已略過：%(reasons)s。"

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "未指定使用設定檔，且未設定 default_profile。"

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "找不到使用設定檔 %(name)r，或其未啟用。"

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "未知模型 %(model_id)r。"

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "設定檔 %(name)r 尚未設定任何模型。"

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "設定檔 %(name)r 沒有可使用的模型。"

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "django-openrouter MVP 尚未實作串流（Streaming）。"

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "已在管理設定中停用 OpenRouter。"

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "尚未設定 OpenRouter API 金鑰。"

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "所有模型皆失敗，且無特定錯誤。"

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter 傳回 HTTP %(status)s：%(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend 需要在 LOG_BACKENDS 項目中提供「URL」（例如 http://"
"localhost:8123）。"

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend：無效的 %(label)s 識別碼 %(identifier)r。"

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS 項目字典需要包含「BACKEND」鍵。"

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS 項目必須為字串或字典，但收到 %(type)s。"

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "無法匯入記錄後端 %(path)r：%(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r 不是 LogBackend 子類別。"

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] 必須是清單。"

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "擷取 GET /api/v1/models，並更新（upsert）本機 OpenRouter 目錄。"

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "覆寫本次執行的 API 金鑰。"

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"新增=%(created)s 更新=%(updated)s 停用=%(deactivated)s 遠端="
"%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "OpenRouter 模型識別碼，例如 anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "每 token 價格：prompt、completion，以及選用的 request/image。"

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "目錄中的 prompt 每 token 價格，供管理介面排序。"

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "目錄中的 completion 每 token 價格，供管理介面排序。"

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "最佳 endpoint 的 p50 TTFT，以毫秒為單位。"

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "最佳 endpoint 的 p50 吞吐量（tok/s）——負載。"

