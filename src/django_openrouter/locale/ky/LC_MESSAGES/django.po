#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Баасы"

#: admin.py:85
msgid "Free"
msgstr "Акысыз"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Арзан (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Орточо ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Кымбат (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Ылдамдык"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Тез (< 400 мс)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Орточо (400-1200 мс)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Жай (>= 1200 мс)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Белгисиз кечикүү"

#: admin.py:136
msgid "API key"
msgstr "API ачкычы"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Сакталган API ачкычын тазалоо"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Ачкыч шифрленип сакталган. Сактоо үчүн бош калтырыңыз, же алмаштыруу үчүн "
"жаңы ачкычты киргизиңиз. Сакталган маани көрсөтүлбөйт."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Бир жолу киргизилет, шифрленип сакталат жана кайра көрсөтүлбөйт. "
"OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] колдонуу үчүн бош "
"калтырыңыз."

#: admin.py:216
msgid "API key status"
msgstr "API ачкычынын абалы"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Сакталган (шифрленген, көрүнбөйт)"

#: admin.py:220
msgid "Not set"
msgstr "Коюлган эмес"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Резервдик модель активдүү болушу керек."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Тизмедеги моделдер активдүү болушу керек."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models параметри акысыз моделдерге гана уруксат берет."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Ар бир модель бир гана жолу болушу мүмкүн."

#: admin.py:293
msgid "Model"
msgstr "Модель"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Моделдер (приоритет боюнча)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Колдонуу профили"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Каталогду OpenRouter менен синхрондоо"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Синхрондоо аяктады: %(created)s түзүлдү, %(updated)s жаңыртылды, "
"%(deactivated)s өчүрүлдү (бардыгы %(total)s алыстан)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Колдонуу профилине дайындоо…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Моделдерди колдонуу профилине дайындоо"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s тизмеде бар"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s активдүү эмес"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s акысыз эмес (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Профиль «%(profile)s»ге %(count)s модель(дер) кошулду."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Профиль «%(profile)s»ге эч кандай модель кошулган жок."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Өткөрүп жиберилди: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Колдонуу профили көрсөтүлгөн эмес жана default_profile орнотулган эмес."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "%(name)r колдонуу профили табылган жок же активдүү эмес."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Белгисиз модель %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "%(name)r профилинде моделдер конфигурацияланган эмес."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "%(name)r профилине уруксат берилген моделдер калган жок."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "django-openrouter MVP'де стриминг ишке ашкан эмес."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter админ жөндөөлөрүндө өчүрүлгөн."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "OpenRouter API ачкычы конфигурацияланган эмес."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Бардык моделдер так ката көрсөтүлбөй иштей алган жок."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter HTTP %(status)s кайтарды: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend үчүн LOG_BACKENDS жазуусунда 'URL' талап кылынат (мис., "
"http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: %(label)s идентификатору %(identifier)r туура эмес."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS жазуусунун dict'инде 'BACKEND' ачкычы болушу керек."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"LOG_BACKENDS жазуулары string же dict болушу керек, ал эми %(type)s алынды."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Лог бэкенди %(path)r импорттолбой жатат: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r — LogBackend'дин subclass эмес."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] list болушу керек."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "GET /api/v1/models'ти алып, жергиликтүү OpenRouter каталогун жаңыртуу."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Бул иштетүү үчүн API ачкычын алмаштыруу."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"түзүлгөн=%(created)s жаңыртылган=%(updated)s өчүрүлгөн=%(deactivated)s "
"алыстан=%(total)s"

#: models.py:45
