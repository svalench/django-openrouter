#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Giá"

#: admin.py:85
msgid "Free"
msgstr "Miễn phí"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Rẻ (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Trung bình ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Đắt (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Tốc độ"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Nhanh (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Trung bình (400-1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Chậm (>= 1200 ms)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Độ trễ không xác định"

#: admin.py:136
msgid "API key"
msgstr "Khóa API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Xóa khóa API đã lưu"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Khóa được lưu dưới dạng mã hóa. Để trống để giữ nguyên khóa hiện tại, hoặc "
"nhập khóa mới để thay thế. Giá trị đã lưu không thể xem được."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Chỉ nhập một lần, được lưu dưới dạng mã hóa và không thể xem lại. Để trống "
"để dùng OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Trạng thái khóa API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Đã lưu (mã hóa, không hiển thị)"

#: admin.py:220
msgid "Not set"
msgstr "Chưa thiết lập"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Mô hình dự phòng phải đang hoạt động."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Các mô hình trong chuỗi phải đang hoạt động."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models chỉ cho phép các mô hình miễn phí."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Mỗi mô hình chỉ được xuất hiện một lần."

#: admin.py:293
msgid "Model"
msgstr "Mô hình"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Các mô hình (thứ tự ưu tiên)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Hồ sơ sử dụng"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Đồng bộ danh mục với OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Đồng bộ hoàn tất: %(created)s đã tạo, %(updated)s đã cập nhật, "
"%(deactivated)s đã vô hiệu hóa (%(total)s từ xa)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Gán cho hồ sơ sử dụng…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Gán mô hình cho hồ sơ sử dụng"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s đã có trong chuỗi"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s không hoạt động"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s không miễn phí (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Đã thêm %(count)s mô hình vào hồ sơ “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Không có mô hình nào được thêm vào hồ sơ “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Đã bỏ qua: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Không có hồ sơ sử dụng nào được chỉ định và default_profile chưa được thiết lập."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Không tìm thấy hồ sơ sử dụng %(name)r hoặc hồ sơ không hoạt động."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Mô hình không xác định %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Hồ sơ %(name)r chưa có mô hình nào được cấu hình."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Không còn mô hình được phép nào cho hồ sơ %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Streaming chưa được triển khai trong django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter bị tắt trong cài đặt quản trị."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Khóa API của OpenRouter chưa được cấu hình."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Tất cả các mô hình đều thất bại mà không có lỗi cụ thể."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter trả về HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend yêu cầu 'URL' trong mục LOG_BACKENDS (ví dụ: http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: định danh %(label)s không hợp lệ %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Từ điển mục LOG_BACKENDS yêu cầu có khóa 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Các mục LOG_BACKENDS phải là chuỗi hoặc từ điển, nhận được %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Không thể nhập log backend %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r không phải là lớp con của LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] phải là một danh sách."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Tải GET /api/v1/models và upsert danh mục OpenRouter cục bộ."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Ghi đè khóa API cho lần chạy này."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"

#: models.py:45
