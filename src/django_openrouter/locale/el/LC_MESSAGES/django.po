msgstr ""
"Ο ημερήσιος προϋπολογισμός (%(budget)s USD) υπερβλήθηκε για το προφίλ %(name)r."

#: rules.py:61
#, python-format
msgid "Monthly budget (%(budget)s USD) exceeded for profile %(name)r."
