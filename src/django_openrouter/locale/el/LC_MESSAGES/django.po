msgstr "Σταθερό slug που χρησιμοποιείται στον κώδικα, π.χ. chat, translation."

#: models.py:116
msgid "First model in the chain (synced from the list)."
msgstr "Πρώτο μοντέλο στην αλυσίδα (συγχρονίζεται από τη λίστα)."

#: models.py:142
msgid "If enabled, only models with zero catalog price may be used."
msgstr ""
"Αν ενεργοποιηθεί, μπορούν να χρησιμοποιηθούν μόνο μοντέλα με μηδενική τιμή "
"καταλόγου."

#: models.py:149
msgid "Usage profiles"
msgstr "Προφίλ χρήσης"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Η θερμοκρασία πρέπει να είναι μεταξύ 0 και 2."

#: models.py:163
msgid "Primary model must be active."
msgstr "Το κύριο μοντέλο πρέπει να είναι ενεργό."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "Το only_free_models απαιτεί δωρεάν κύριο μοντέλο."

#: models.py:263
msgid "Profile model"
msgstr "Μοντέλο προφίλ"

#: models.py:264
msgid "Profile models"
msgstr "Μοντέλα προφίλ"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "Το only_free_models επιτρέπει μόνο δωρεάν εναλλακτικά μοντέλα."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Αφήστε το κενό για χρήση του OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "Χρονικό όριο HTTP σε δευτερόλεπτα."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr ""
"Επαναλήψεις ανά μοντέλο για σφάλματα μεταφοράς / 5xx πριν την εναλλαγή."

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr ""
"Γενικός διακόπτης απενεργοποίησης. Όταν είναι κλειστός, κάθε κλήση chat() "
"αποτυγχάνει."

#: models.py:312 models.py:313 models.py:316
msgid "OpenRouter settings"
msgstr "Ρυθμίσεις OpenRouter"

#: models.py:360
msgid "Request log"
msgstr "Αρχείο καταγραφής αιτημάτων"

#: models.py:361
