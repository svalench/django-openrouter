#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "يجب أن تكون مداخل LOG_BACKENDS سلاسل نصية أو قواميس، وتم استلام %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "تعذّر استيراد وحدة تسجيل السجل %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r ليس فئة فرعية من LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "يجب أن يكون OPENROUTER['LOG_BACKENDS'] قائمة."

