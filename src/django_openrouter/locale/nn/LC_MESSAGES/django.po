#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Synkronisering fullført: %(created)s oppretta, %(updated)s oppdatert, "
"%(deactivated)s deaktivert (%(total)s eksterne)."

