#: admin.py:136
msgid "API key"
msgstr "Clave API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Borrar la clave API guardada"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"La clave ta guardada cifrada. Dexa'l campu baleru pa caltenela, o escribi "
"una clave nueva pa sustituyila. El valor guardáu nun puede visualizase."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"S'escribe una vegada, guardar cifrada y nun pue visualizase otra vegada. "
"Dexa'l campu baleru pa usar OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Estáu de la clave API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Guardada (cifrada, non visible)"

#: admin.py:220
msgid "Not set"
msgstr "Nun ta definida"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "El modelu de respaldu tien de tar activu."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Los modelos de la cadena tienen de tar activos."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models permite namás modelos gratuitos."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Cada modelu pue apaecer namás una vegada."

#: admin.py:293
msgid "Model"
msgstr "Modelu"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modelos (orde de prioridá)"

