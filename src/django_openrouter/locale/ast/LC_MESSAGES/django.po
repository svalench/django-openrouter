msgid "Usage profile"
msgstr "Perfil d'usu"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Sincronizar el catálogu con OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Sincronización completa: %(created)s creaos, %(updated)s anovaos, "
"%(deactivated)s desactivaos (%(total)s remotos)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Asignar a un perfil d'usu…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Asignar modelos a un perfil d'usu"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s yá na cadena"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s inactivos"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s non gratuitos (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Añadiéronse %(count)s modelos al perfil «%(profile)s»."

