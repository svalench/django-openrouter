#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "El perfil %(name)r nun tien modelos configuraos."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Nun queden modelos permitíos pal perfil %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "El streaming nun ta implementáu nel MVP de django-openrouter."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter ta desactiváu na configuración de l'alministración."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "La clave API d'OpenRouter nun ta configurada."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Fallaron tolos modelos ensin un error específicu."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter devolvió HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend requier 'URL' na entrada de LOG_BACKENDS (p. ex. "
"http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: identificador %(identifier)r de %(label)s inválidu."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "El diccionariu de la entrada LOG_BACKENDS requier una clave 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Les entraes de LOG_BACKENDS tienen de ser cadenes o diccionarios; recibiose %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Nun se pue importar el backend de rexistru %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r nun ye una subclase de LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] tien de ser una llista."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Recibe GET /api/v1/models y anueva el catálogu llocal d'OpenRouter (upsert)."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Anular la clave API pa esta execución."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"creaos=%(created)s anovaos=%(updated)s desactivaos=%(deactivated)s "
"remotos=%(total)s"

#: models.py:45
