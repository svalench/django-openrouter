#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Nun s'añadió nengún modelu al perfil «%(profile)s»."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Omitíos: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Nun s'especificó nengún perfil d'usu y default_profile nun ta definíu."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "El perfil d'usu %(name)r nun s'atopó o ta inactivu."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Modelu desconocíu %(model_id)r."

