#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend chọrọ 'URL' n'ime ntinye LOG_BACKENDS (dịka http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: njirimara %(label)s na-ezighi ezi %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Ntinye dict LOG_BACKENDS chọrọ igodo 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Ntinye LOG_BACKENDS ga-abụrịrị strings ma ọ bụ dicts, a natara %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Enweghị ike ịbubata log backend %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r abụghị LogBackend subclass."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] ga-abụrịrị list."

