msgstr "Kpochapu igodo API echekwara"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Igodo echekwara n'ụzọ nzuzo. Hapụ oghere ka ọ bụ efu ka ịhazi ya, ma ọ bụ "
"tinye igodo ọhụrụ ka ọ sachapụ ya. A gaghị ahụ ebe echekwara."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"A na-etinye ya otu ugboro, echekwara ya n'ụzọ nzuzo, a gaghị ahụ ya ọzọ. "
"Hapụ oghere ka ọ bụ efu iji OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Ọnọdụ igodo API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Echekwara (n'ụzọ nzuzo, a gaghị ahụ)"

#: admin.py:220
msgid "Not set"
msgstr "Agbakwunyewo"

