#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Verð"

#: admin.py:85
msgid "Free"
msgstr "Ókeypis"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Ódýrt (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Miðlungs ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Dýrt (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Hraði"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Hratt (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Miðlungs (400-1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Hægt (>= 1200 ms)"

