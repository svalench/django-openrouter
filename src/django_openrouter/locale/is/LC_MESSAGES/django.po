msgstr "Samstilla vörulista við OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Samstillingu lokið: %(created)s búin til, %(updated)s uppfærð, "
"%(deactivated)s óvirkjað (%(total)s fjartengd)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Úthluta á notkunarsnið…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Úthluta líkönum á notkunarsnið"

