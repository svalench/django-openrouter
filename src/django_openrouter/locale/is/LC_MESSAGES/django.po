msgid "Unknown latency"
msgstr "Óþekkt töf"

#: admin.py:136
msgid "API key"
msgstr "API-lykill"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Hreinsa geymdan API-lykil"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Lykill er geymdur dulkóðaður. Skiljið eftir autt til að halda honum, eða "
"sláið inn nýjan lykil til að skipta um hann. Ekki er hægt að skoða geymda "
"gildið."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Sláið inn einu sinni, geymt dulkóðað og ekki hægt að skoða aftur. Skiljið "
"eftir autt til að nota OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Staða API-lykils"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Geymt (dulkóðað, ekki sýnilegt)"

#: admin.py:220
msgid "Not set"
msgstr "Ekki stillt"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Varalíkan verður að vera virkt."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Líkön í keðjunni verða að vera virk."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models leyfir einungis ókeypis líkön."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Hvert líkan má aðeins koma fyrir einu sinni."

#: admin.py:293
msgid "Model"
msgstr "Líkan"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Líkön (eftir forgangi)"

