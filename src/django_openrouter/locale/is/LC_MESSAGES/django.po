#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Bætti %(count)s líkönum við snið „%(profile)s“."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Engum líkum var bætt við snið „%(profile)s“."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Sleppt: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Ekkert notkunarsnið tilgreint og default_profile er ekki stillt."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Notkunarsnið %(name)r finnst ekki eða er ekki virkt."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Óþekkt líkan %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Snið %(name)r hefur engin líkön stillt."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Engin leyfð líkön eftir fyrir snið %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Streymi (streaming) er ekki útfært í django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter er óvirkt í stillingum stjórnanda."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "OpenRouter API-lykill er ekki stilltur."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Öllum líkönum mistókst án ákveðinnar villu."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter skilaði HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend krefst „URL“ í LOG_BACKENDS færslunni (t.d. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: ógilt %(label)s auðkenni %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS færsla (dict) krefst „BACKEND“ lykils."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS færslur verða að vera strengir eða dict, fékk %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Get ekki flutt inn skrár-bakenda %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r er ekki undirflokkur LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] verður að vera listi."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Sækir GET /api/v1/models og upsert-ar staðbundinn OpenRouter-vörulista."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Notar annan API-lykil fyrir þessa keyrslu."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"búin til=%(created)s uppfærð=%(updated)s óvirkjað=%(deactivated)s "
"fjartengd=%(total)s"

