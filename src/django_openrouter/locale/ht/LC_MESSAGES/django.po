#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Pri"

#: admin.py:85
msgid "Free"
msgstr "Gratis"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Bon mache (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Mwayen ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Chè (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Rapidite"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Rapid (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Mwayen (400-1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Dousman (>= 1200 ms)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Latans enkoni"

#: admin.py:136
msgid "API key"
msgstr "Kle API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Efase kle API ki stoke a"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Yon kle stoke yo an chifreman. Kite chan an vid pou l rete, oswa antre yon "
"nouvo kle pou ranplase l. Ou pa ka wè valè ki stoke a."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Antre yon fwa, stoke an chifreman, epi ou pa ka wè l ankò. Kite l vid pou "
"itilize OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Estati kle API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Stoke (an chifreman, pa vizib)"

#: admin.py:220
msgid "Not set"
msgstr "Pa konfigire"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Modèl rezèv la dwe aktif."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Tout modèl nan chenn nan dwe aktif."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models pèmèt sèlman modèl gratis."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Chak modèl ka parèt yon fwa sèlman."

#: admin.py:293
msgid "Model"
msgstr "Modèl"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modèl (òd priyorite)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Pwofil itilizasyon"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Senkronize katolog la ak OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Senkronizasyon fini: %(created)s kreye, %(updated)s mete ajou, "
"%(deactivated)s deactivate (%(total)s byen lwen)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Asiyen yon pwofil itilizasyon…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Asiyen modèl yo bay yon pwofil itilizasyon"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s deja nan chenn nan"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s inaktif"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s pa gratis (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Ajoute %(count)s modèl nan pwofil “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Okenn modèl pa te ajoute nan pwofil “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Sote: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Okenn pwofil itilizasyon pa presize epi default_profile pa konfigire."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Pwofil itilizasyon %(name)r pa jwenn oswa li inaktif."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Modèl %(model_id)r enkoni."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Pwofil %(name)r pa gen okenn modèl konfigire."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Pa gen okenn modèl otorize ki rete pou pwofil %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Streaming pa implemente nan django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter a dezaktive nan paramèt admin yo."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Kle API OpenRouter a pa konfigire."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Tout modèl yo echwe san yon erè espesifik."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter retounen HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend mande yon 'URL' nan antre LOG_BACKENDS la (pa egzanp "
"http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: idantifyan %(label)s %(identifier)r pa valab."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Diksyonè antre LOG_BACKENDS la mande yon kle 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Antre LOG_BACKENDS yo dwe chenn oswa diksyonè, resevwa %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Pa ka enpòte log backend %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r se pa yon souklas LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] dwe yon lis."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Rekipere GET /api/v1/models epi mete ajou katolog lokal OpenRouter la."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Ranplase kle API pou egzekisyon sa a."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"kreye=%(created)s mete_ajou=%(updated)s deactivate=%(deactivated)s "
"byen_lwen=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "ID modèl OpenRouter, pa egzanp anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "Pri pa tokens: prompt, completion, demann/imaj si nesesè."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "Pri prompt la pa token, soti nan katolog la, pou tri nan admin."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "Pri completion nan pa token, soti nan katolog la, pou tri nan admin."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "TTFT p50 pou pi bon endpoint la, an milisegond."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "debit p50 (tok/s) pou pi bon endpoint la — chaj."

