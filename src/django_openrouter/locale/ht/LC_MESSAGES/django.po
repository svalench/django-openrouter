msgstr "Modèl prensipal la dwe aktif."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "only_free_models mande yon modèl prensipal gratis."

#: models.py:263
msgid "Profile model"
msgstr "Modèl pwofil"

#: models.py:264
msgid "Profile models"
msgstr "Modèl pwofil"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models pèmèt sèlman modèl rezèv gratis."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr "Kite l vid pou itilize OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "Tan limit HTTP an segond."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr "Eseye anko pou chak modèl sou erè transpò / 5xx anvan rezèv."

#: models.py:308
