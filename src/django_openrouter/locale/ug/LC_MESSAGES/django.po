msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"بىر ئاچقۇچ شىفىرلانغان ھالدە ساقلانغان. ساقلاش ئۈچۈن بوش قويۇڭ، ياكى "
"ئالماشتۇرۇش ئۈچۈن يېڭى ئاچقۇچ كىرگۈزۈڭ. ساقلانغان قىممەت كۆرسىتىلەلمەيدۇ."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"بىر قېتىم كىرگۈزۈلىدۇ، شىفىرلانغان ھالدە ساقلىنىدۇ، قايتا كۆرسىتىلەلمەيدۇ. "
"OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] نى ئىشلىتىش ئۈچۈن بوش قويۇڭ."

