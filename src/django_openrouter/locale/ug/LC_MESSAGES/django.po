msgstr "ClickHouseBackend: ئىناۋەتسىز %(label)s بەلگىسى %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS تۈر لۇغىتىدە «BACKEND» ئاچقۇچى بولۇشى كېرەك."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS تۈرلىرى ھەرپ-بەلگە تىزىقى ياكى لۇغەت بولۇشى كېرەك، تېپىلغىنى %(type)s."

#: log_backends.py:257
#, python-format
