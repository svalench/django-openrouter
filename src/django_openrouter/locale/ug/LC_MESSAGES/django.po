msgstr "%(path)r LogBackend تارمىقى ئەمەس."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] تىزىم بولۇشى كېرەك."

