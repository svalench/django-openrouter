#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend نىڭ LOG_BACKENDS تۈرىدە «URL» بولۇشى كېرەك (مەسىلەن http://"
"localhost:8123)."

