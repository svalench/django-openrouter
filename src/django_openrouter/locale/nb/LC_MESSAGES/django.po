#: admin.py:136
msgid "API key"
msgstr "API-nøkkel"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Fjern lagret API-nøkkel"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"En nøkkel lagres kryptert. La feltet stå tomt for å beholde den, eller "
"skriv inn en ny nøkkel for å erstatte den. Den lagrede verdien kan ikke "
"vises."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Skrives inn én gang, lagres kryptert og kan ikke vises igjen. La stå tomt "
"for å bruke OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Status for API-nøkkel"

#: admin.py:219
