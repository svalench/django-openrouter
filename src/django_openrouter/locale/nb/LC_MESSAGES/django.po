#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Synkronisering fullført: %(created)s opprettet, %(updated)s oppdatert, "
"%(deactivated)s deaktivert (%(total)s eksterne)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Tildel til bruksprofil…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Tildel modeller til bruksprofil"

