#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend requiere 'URL' en la entrada LOG_BACKENDS (p. ej. "
"http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: identificador %(label)s no válido %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "El diccionario de entrada de LOG_BACKENDS requiere una clave 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"Las entradas de LOG_BACKENDS deben ser cadenas o diccionarios, se recibió "
"%(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "No se puede importar el backend de registro %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r no es una subclase de LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] debe ser una lista."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr ""
"Obtiene GET /api/v1/models y actualiza el catálogo local de OpenRouter."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Anular la clave de API para esta ejecución."

#: management/commands/sync_models.py:31
#, python-format
