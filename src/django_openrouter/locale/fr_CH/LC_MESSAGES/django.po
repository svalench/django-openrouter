#: admin.py:136
msgid "API key"
msgstr "Clé API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Effacer la clé API enregistrée"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Une clé est enregistrée chiffrée. Laissez vide pour la conserver, ou saisissez "
"une nouvelle clé pour la remplacer. La valeur enregistrée ne peut pas être "
"affichée."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Saisie une fois, enregistrée chiffrée, elle ne peut plus être affichée. "
"Laissez vide pour utiliser OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Statut de la clé API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Enregistrée (chiffrée, non visible)"

#: admin.py:220
msgid "Not set"
msgstr "Non définie"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Le modèle de secours doit être actif."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Les modèles de la chaîne doivent être actifs."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models n'autorise que les modèles gratuits."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Chaque modèle ne peut apparaître qu'une seule fois."

#: admin.py:293
msgid "Model"
msgstr "Modèle"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modèles (ordre de priorité)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Profil d'utilisation"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Synchroniser le catalogue avec OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Synchronisation terminée : %(created)s créés, %(updated)s mis à jour, "
"%(deactivated)s désactivés (%(total)s distants)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Assigner à un profil d'utilisation…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Assigner des modèles à un profil d'utilisation"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s déjà présents dans la chaîne"

#: admin.py:535
#, python-format
