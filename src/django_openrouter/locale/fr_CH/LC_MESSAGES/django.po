msgstr "%(count)s non gratuits (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "%(count)s modèle(s) ajouté(s) au profil « %(profile)s »."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Aucun modèle n'a été ajouté au profil « %(profile)s »."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Ignorés : %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr ""
"Aucun profil d'utilisation spécifié et default_profile n'est pas défini."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Le profil d'utilisation %(name)r est introuvable ou inactif."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Modèle inconnu : %(model_id)r."

