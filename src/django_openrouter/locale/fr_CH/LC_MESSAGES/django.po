msgstr "Le profil %(name)r n'a aucun modèle configuré."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Aucun modèle autorisé restant pour le profil %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Le streaming n'est pas implémenté dans le MVP de django-openrouter."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter est désactivé dans les paramètres d'administration."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "La clé API OpenRouter n'est pas configurée."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Tous les modèles ont échoué sans erreur spécifique."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter a renvoyé HTTP %(status)s : %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend exige une clé « URL » dans l'entrée LOG_BACKENDS (par ex. "
"http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend : identifiant %(label)s invalide %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Le dictionnaire d'entrée LOG_BACKENDS exige une clé « BACKEND »."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"Les entrées LOG_BACKENDS doivent être des chaînes ou des dictionnaires, "
"obtenu : %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Impossible d'importer le backend de journalisation %(path)r : %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r n'est pas une sous-classe de LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] doit être une liste."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr ""
"Récupère GET /api/v1/models et insère/met à jour le catalogue OpenRouter "
"local."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Remplace la clé API pour cette exécution."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"créés=%(created)s mis à jour=%(updated)s désactivés=%(deactivated)s "
"distant=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "Identifiant du modèle OpenRouter, par ex. anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr ""
"Prix par jeton : prompt, completion, requête/image en option."

