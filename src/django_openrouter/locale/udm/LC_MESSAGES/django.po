msgid "Models in the chain must be active."
msgstr "Цепочкаысь модельёс активнойёс луым быгатэм."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models бызьёс луэ гинэ бесплатной модельёс."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Пичи модель бызьёс гинэ нуллыны кулэ."

#: admin.py:293
msgid "Model"
msgstr "Модель"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Модельёс (приоритет порядок)"

