#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Каталогэз OpenRouter-лы котыртон"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Котыртон пыре: луэм %(created)s, пондемын %(updated)s, уксэм %(deactivated)s "
"(%(total)s удалённой)."

