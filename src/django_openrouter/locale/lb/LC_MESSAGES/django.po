#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend braucht 'URL' an der LOG_BACKENDS-Entrée (z. B. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: ongëltegen %(label)s-Identifier %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "De LOG_BACKENDS-Dict braucht e 'BACKEND'-Schlëssel."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS-Entréë mussen Strings oder Dicts sinn, kritt %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Kann Log-Backend %(path)r net importéieren: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r ass keng LogBackend-Ënnerklass."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] muss eng Lëscht sinn."

#: management/commands/sync_models.py:11
