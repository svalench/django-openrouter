msgstr "OpenRouter HTTP %(status)s буцаалаа: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend LOG_BACKENDS бичлэгт 'URL' шаарддаг (жишээ нь http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: %(label)s танигч %(identifier)r хүчингүй."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS бичлэгийн dict 'BACKEND' түлхүүр шаарддаг."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"LOG_BACKENDS бичлэгүүд тэмдэгт мөр эсвэл dict байх ёстой, %(type)s ирлээ."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Лог backend %(path)r-г импортлох боломжгүй: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r нь LogBackend дэд класс биш байна."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] жагсаалт байх ёстой."

#: management/commands/sync_models.py:11
