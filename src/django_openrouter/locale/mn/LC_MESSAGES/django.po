msgstr "%(name)r ашиглалтын профайл олдсонгүй эсвэл идэвхгүй байна."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Танигдаагүй загвар %(model_id)r."

