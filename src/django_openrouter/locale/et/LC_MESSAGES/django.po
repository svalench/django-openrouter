msgstr "only_free_models nõuab tasuta primaarset mudelit."

#: models.py:263
msgid "Profile model"
msgstr "Profiili mudel"

#: models.py:264
msgid "Profile models"
msgstr "Profiili mudelid"

#: models.py:277
