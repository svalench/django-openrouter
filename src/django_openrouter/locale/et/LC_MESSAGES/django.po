msgstr "only_free_models lubab ainult tasuta varumudeleid."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Jäta tühjaks, et kasutada OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "HTTP ajapiirang sekundites."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr ""
"Korduskatsed mudeli kohta transpordi-/5xx-vigade korral enne varumudelile "
