#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Hind"

#: admin.py:85
msgid "Free"
msgstr "Tasuta"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Odav (< 1 $ / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Keskmine (1-10 $ / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Kallis (>= 10 $ / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Kiirus"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Kiire (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Keskmine (400-1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Aeglane (>= 1200 ms)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Tundmatu viivitus"

#: admin.py:136
msgid "API key"
msgstr "API-võti"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Kustuta salvestatud API-võti"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Võti on salvestatud krüpteeritult. Jäta tühjaks, et see säilitada, või "
"sisesta uus võti selle asendamiseks. Salvestatud väärtust ei saa vaadata."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Sisestatakse üks kord, salvestatakse krüpteeritult ja seda ei saa hiljem "
"uuesti vaadata. Jäta tühjaks, et kasutada OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "API-võtme olek"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Salvestatud (krüpteeritud, pole nähtav)"

#: admin.py:220
msgid "Not set"
msgstr "Määramata"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Varumudel peab olema aktiivne."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Ahela mudelid peavad olema aktiivsed."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models lubab ainult tasuta mudeleid."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Iga mudel võib esineda ainult ühe korra."

#: admin.py:293
msgid "Model"
msgstr "Mudel"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Mudelid (prioriteedi järjekorras)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Kasutusprofiil"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Sünkroniseeri kataloog OpenRouteriga"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Sünkroonimine lõpetatud: loodud %(created)s, uuendatud %(updated)s, "
"deaktiveeritud %(deactivated)s (%(total)s kaugserveris)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Määra kasutusprofiilile…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Määra mudeleid kasutusprofiilile"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s juba ahelas"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s mitteaktiivset"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s mitte tasuta (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Lisatud %(count)s mudel(it) profiilile „%(profile)s“."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Profiilile „%(profile)s“ ei lisatud ühtegi mudelit."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Vahele jäetud: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Kasutusprofiili pole määratud ja default_profile pole seatud."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Kasutusprofiili %(name)r ei leitud või see pole aktiivne."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Tundmatu mudel %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Profiilil %(name)r pole ühtegi mudelit seadistatud."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Profiilil %(name)r pole lubatud mudeleid alles."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Voogesitust pole django-openrouter MVP-s rakendatud."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter on administreerimisseadetes keelatud."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "OpenRouteri API-võtit pole seadistatud."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Kõik mudelid ebaõnnestusid ilma konkreetse veata."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter tagastas HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend nõuab LOG_BACKENDS-kirjes võtit 'URL' (nt http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: sobimatu %(label)s-identifikaator %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS-kirje sõnastik nõuab võtit 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS-kirjed peavad olema sõned või sõnastikud, saadi %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Logimistagaka %(path)r importimine ebaõnnestus: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r ei ole LogBackend-i alamklass."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] peab olema loend."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Hangi GET /api/v1/models ja uuenda kohalikku OpenRouteri kataloogi."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Kirjuta selle käivituse API-võti üle."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "OpenRouteri mudeli id, nt anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "Hinnad ühe tokendi kohta: prompt, completion, valikuline päring/pilt."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "Prompt-hind tokendi kohta kataloogist, administraatori sortimiseks."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "Completion-hind tokendi kohta kataloogist, administraatori sortimiseks."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "Parima endpoint-i p50 TTFT millisekundites."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "Parima endpoint-i läbilaskevõime p50 (tok/s) — koormus."

