#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Bei"

#: admin.py:85
msgid "Free"
msgstr "Bure"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Nafuu (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Ya kati ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Ghali (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Kasi"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Ya haraka (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Ya kati (400-1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Polepole (>= 1200 ms)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Ucheleweshaji haujulikani"

#: admin.py:136
msgid "API key"
msgstr "Ufunguo wa API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Futa ufunguo wa API uliohifadhiwa"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Ufunguo umehifadhiwa kwa usimbaji. Acha wazi kuihifadhi, au ingiza ufunguo "
"mpya kuibadilisha. Thamani iliyohifadhiwa haiwezi kuonekana."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Huwekwa mara moja, huhifadhiwa kwa usimbaji, na hauwezi kuonekana tena. Acha "
"wazi kutumia OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Hali ya ufunguo wa API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Imehifadhiwa (imesimbwa, haionekani)"

#: admin.py:220
msgid "Not set"
msgstr "Haijawekwa"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Modeli badala lazima iwe hai."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Modeli katika mnyororo lazima ziwe hai."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models inaruhusu tu modeli za bure."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Kila modeli inaweza kuonekana mara moja tu."

#: admin.py:293
msgid "Model"
msgstr "Modeli"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modeli (mpangilio wa kipaumbele)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Wasifu wa matumizi"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Sawazisha katalogi na OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Usawazishaji umekamilika: %(created)s zimeundwa, %(updated)s zimesasishwa, "
"%(deactivated)s zimezimwa (%(total)s mbali)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Kabidhi kwa wasifu wa matumizi…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Kabidhi modeli kwa wasifu wa matumizi"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s tayari katika mnyororo"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s hazitumiki"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s sio za bure (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Modeli %(count)s zimeongezwa kwa wasifu “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Hakuna modeli zilizoongezwa kwa wasifu “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Zimerukwa: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Hakuna wasifu wa matumizi uliobainishwa na default_profile haijawekwa."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Wasifu wa matumizi %(name)r haujapatikana au hautumiki."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Modeli isiyojulikana %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Wasifu %(name)r huna modeli zilizosanidiwa."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Hakuna modeli zinazoruhusiwa zilizobaki kwa wasifu %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Streaming haijatekelezwa katika django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter imezimwa katika mipangilio ya usimamizi."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Ufunguo wa API wa OpenRouter haujasanidiwa."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Modeli zote zimeshindwa bila kosa maalum."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter imerudisha HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend inahitaji 'URL' katika kipengee cha LOG_BACKENDS (k.m. "
"http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: kitambulisho %(identifier)r si sahihi cha %(label)s."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Kamusi ya kipengee cha LOG_BACKENDS inahitaji ufunguo wa 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Vipengee vya LOG_BACKENDS lazima viwe mistari au kamusi, imepata %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Haiwezi kuleta backend ya kumbukumbu %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r si kizazi cha LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] lazima iwe orodha."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Leta GET /api/v1/models na ufanye upsert kwa katalogi ya ndani ya OpenRouter."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Badilisha ufunguo wa API kwa mzunguko huu."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "Kitambulisho cha modeli ya OpenRouter, k.m. anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "Bei za kila tokeni: prompt, completion, ombi/picha hiari."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "Bei ya prompt kwa kila tokeni kutoka katalogi, kwa upangaji wa usimamizi."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "Bei ya completion kwa kila tokeni kutoka katalogi, kwa upangaji wa usimamizi."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "p50 TTFT ya endpoint bora, kwa milisekunde."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "p50 throughput (tok/s) ya endpoint bora — upakiaji."

