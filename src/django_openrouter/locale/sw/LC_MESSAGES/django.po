msgstr "Slug thabiti inayotumika katika msimbo, k.m. chat, tafsiri."

#: models.py:116
msgid "First model in the chain (synced from the list)."
msgstr "Modeli ya kwanza katika mnyororo (imesawazishwa kutoka orodha)."

#: models.py:142
msgid "If enabled, only models with zero catalog price may be used."
msgstr "Ikiwashwa, modeli zenye bei sifuri tu katika katalogi zinaweza kutumika."

#: models.py:149
msgid "Usage profiles"
msgstr "Wasifu wa matumizi"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Joto lazima liwe kati ya 0 na 2."

#: models.py:163
msgid "Primary model must be active."
msgstr "Modeli kuu lazima iwe hai."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "only_free_models inahitaji modeli kuu ya bure."

#: models.py:263
msgid "Profile model"
msgstr "Modeli ya wasifu"

#: models.py:264
msgid "Profile models"
msgstr "Modeli za wasifu"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models inaruhusu tu modeli badala za bure."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr "Acha wazi kutumia OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "Muda wa kusubiri HTTP kwa sekunde."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr ""
"Marudio kwa kila modeli kwa makosa ya usafirishaji / 5xx kabla ya kutumia "
"modeli badala."

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr "Kizimaji kimataifa. Kizimwapo, kila ombi la chat() hushindwa."

