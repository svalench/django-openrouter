msgstr "Bajeti ya kila siku (%(budget)s USD) imezidiwa kwa wasifu %(name)r."

#: rules.py:61
#, python-format
msgid "Monthly budget (%(budget)s USD) exceeded for profile %(name)r."
msgstr "Bajeti ya kila mwezi (%(budget)s USD) imezidiwa kwa wasifu %(name)r."

#: rules.py:69
#, python-format
msgid "Model %(model_id)r is disabled."
msgstr "Modeli %(model_id)r imezimwa."

#: rules.py:72
