#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend vereist 'URL' in de LOG_BACKENDS-vermelding (bijv. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: ongeldige %(label)s-identifier %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS-vermelding als dict vereist een 'BACKEND'-sleutel."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS-vermeldingen moeten strings of dicts zijn, %(type)s ontvangen."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Kan log-backend %(path)r niet importeren: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r is geen LogBackend-subklasse."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] moet een lijst zijn."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "GET /api/v1/models ophalen en de lokale OpenRouter-catalogus bijwerken (upsert)."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "API-sleutel voor deze uitvoering overschrijven."

#: management/commands/sync_models.py:31
#, python-format
