#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Գին"

#: admin.py:85
msgid "Free"
msgstr "Անվճար"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Էժան (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Միջին ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Թանկ (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Արագություն"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Արագ (< 400 մվ)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Միջին (400-1200 մվ)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Դանդաղ (>= 1200 մվ)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Անհայտ ուշացում"

#: admin.py:136
msgid "API key"
msgstr "API բանալի"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Մաքրել պահված API բանալին"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Բանալին պահված է ծածկագրված։ Թողեք դատարկ՝ այն պահելու համար, կամ մուտքագրեք "
"նոր՝ փոխարինելու համար։ Պահված արժեքը հնարավոր չէ դիտել։"

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Մուտքագրվում է մեկ անգամ, պահվում է ծածկագրված և այլևս հնարավոր չէ դիտել։ "
"Թողեք դատարկ՝ OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']-ն օգտագործելու "
"համար։"

#: admin.py:216
msgid "API key status"
msgstr "API բանալու կարգավիճակ"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Պահված (ծածկագրված, անտեսանելի)"

#: admin.py:220
msgid "Not set"
msgstr "Սահմանված չէ"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Պահուստային մոդելը պետք է ակտիվ լինի։"

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Շղթայի մոդելները պետք է ակտիվ լինեն։"

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models-ը թույլ է տալիս միայն անվճար մոդելներ։"

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Յուրաքանչյուր մոդել կարող է հանդիպել միայն մեկ անգամ։"

#: admin.py:293
msgid "Model"
msgstr "Մոդել"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Մոդելներ (առաջնահերթությամբ)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Օգտագործման պրոֆիլ"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Սինքրոնիզել կատալոգը OpenRouter-ի հետ"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Սինքրոնիզացումն ավարտված է. ստեղծվել՝ %(created)s, թարմացվել՝ %(updated)s, "
"ապաակտիվացվել՝ %(deactivated)s (հեռակա՝ %(total)s)։"

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Նշանակել օգտագործման պրոֆիլին…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Նշանակել մոդելները օգտագործման պրոֆիլին"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "Շղթայում արդեն կա՝ %(count)s"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "Ապաակտիվ՝ %(count)s"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "Վճարովի՝ %(count)s (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "«%(profile)s» պրոֆիլին ավելացվել է %(count)s մոդել։"

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "«%(profile)s» պրոֆիլին մոդելներ չեն ավելացվել։"

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Բաց թողնված՝ %(reasons)s։"

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Օգտագործման պրոֆիլ նշված չէ, իսկ default_profile-ը սահմանված չէ։"

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "%(name)r օգտագործման պրոֆիլը գտնված չէ կամ ապաակտիվ է։"

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Անհայտ մոդել՝ %(model_id)r։"

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "%(name)r պրոֆիլում մոդելներ կարգավորված չեն։"

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "%(name)r պրոֆիլի համար թույլատրված մոդելներ չեն մնացել։"

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Հոսքային (streaming) աջակցությունը դեռ իրականացված չէ django-openrouter MVP-ում։"

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter-ն անջատված է ադմինիստրատորի կարգավորումներում։"

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "OpenRouter-ի API բանալին կարգավորված չէ։"

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Բոլոր մոդելները ձախողվեցին առանց հատուկ սխալի։"

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter-ը վերադարձրեց HTTP %(status)s՝ %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend-ը պահանջում է 'URL' LOG_BACKENDS գրառման մեջ (օր.՝ http://"
"localhost:8123)։"

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend՝ անվավեր %(label)s նույնացուցիչ %(identifier)r։"

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS-ի dict գրառումը պահանջում է 'BACKEND' բանալի։"

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS գրառումները պետք է լինեն string կամ dict տիպի, ստացվել է %(type)s։"

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Հնարավոր չէ ներմուծել %(path)r լոգավորման բեքենդը՝ %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r-ը LogBackend-ի ենթադաս չէ։"

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS']-ը պետք է լինի ցուցակ։"

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Ստանալ GET /api/v1/models-ը և թարմացնել տեղական OpenRouter կատալոգը։"

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Վերասահմանել API բանալին այս գործարկման համար։"

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"ստեղծվել=%(created)s թարմացվել=%(updated)s ապաակտիվացվել=%(deactivated)s "
"հեռակա=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "OpenRouter-ի մոդելի id, օր.՝ anthropic/claude-3.5-sonnet"

#: models.py:52
