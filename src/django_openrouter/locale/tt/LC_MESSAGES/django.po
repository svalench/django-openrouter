msgstr "Ҡулланыу профиле күрһәтелмәгән һәм default_profile көйләнмәгән."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "%(name)r ҡулланыу профиле табылманы йәки эшләмәй."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "%(model_id)r моделе билгеһеҙ."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "%(name)r профилендә моделләр көйләнмәгән."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "%(name)r профиле өсөн рөхсәт ителгән моделләр ҡалмаған."

