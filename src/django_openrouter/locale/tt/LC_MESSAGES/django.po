msgstr "OpenRouter менән каталогты синхронлаштырыу"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Синхронлаштырыу тамамланды: яңы %(created)s, яңартылған %(updated)s, "
"һүндерелгән %(deactivated)s (алыҫтағы %(total)s)."

