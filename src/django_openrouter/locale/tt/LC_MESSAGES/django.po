msgstr "OpenRouter API-ключы көйләнмәгән."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Бар моделләр ҙә махсус хатаһыҙ уңышһыҙ булды."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter HTTP %(status)s ҡайтарҙы: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend өсөн LOG_BACKENDS яҙыуында 'URL' кәрәк (мәҫәлән, http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: %(label)s өсөн дөрөҫ булмаған идентификатор %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS яҙыуының dict-ында 'BACKEND' ачары кәрәк."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS яҙыуылары строка йәки dict булырға тейеш, алынған: %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Журнал бэкенды %(path)r инпортланмай: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r — LogBackend субклассы түгел."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] список булырға тейеш."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "GET /api/v1/models алырға һәм урындағы OpenRouter каталогын яңыртырға."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Был эшләү өсөн API-ключты алыштырырға."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"яһалды=%(created)s яңартылды=%(updated)s һүндерелде=%(deactivated)s "
"алыҫта=%(total)s"

