msgid "only_free_models allows only free models."
msgstr "only_free_models тик бушлай моделләргә рөхсәт итә."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Һәр модель бер генә тапҡыр осрашырға тейеш."

#: admin.py:293
msgid "Model"
