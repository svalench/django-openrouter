msgstr "Az only_free_models csak ingyenes tartalékmodelleket engedélyez."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr "Hagyja üresen az OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] használatához."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "HTTP időtúllépés másodpercben."

#: models.py:304
