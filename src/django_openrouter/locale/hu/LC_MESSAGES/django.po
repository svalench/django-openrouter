msgstr "Ha engedélyezve van, csak nulla katalógusáras modellek használhatók."

#: models.py:149
msgid "Usage profiles"
msgstr "Használati profilok"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "A temperature értékének 0 és 2 között kell lennie."

#: models.py:163
msgid "Primary model must be active."
msgstr "Az elsődleges modellnek aktívnak kell lennie."

#: models.py:166
