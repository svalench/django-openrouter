msgstr "Az only_free_models ingyenes elsődleges modellt igényel."

#: models.py:263
msgid "Profile model"
msgstr "Profilmodell"

#: models.py:264
msgid "Profile models"
msgstr "Profilmodellek"

#: models.py:277
