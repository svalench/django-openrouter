#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Ár"

#: admin.py:85
msgid "Free"
msgstr "Ingyenes"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Olcsó (< 1 USD / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Közepes (1–10 USD / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Drága (≥ 10 USD / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Sebesség"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Gyors (< 400 ms)"

#: admin.py:106
msgid "Medium (400-1200 ms)"
msgstr "Közepes (400–1200 ms)"

#: admin.py:107
msgid "Slow (>= 1200 ms)"
msgstr "Lassú (≥ 1200 ms)"

#: admin.py:108
msgid "Unknown latency"
msgstr "Ismeretlen késleltetés"

#: admin.py:136
msgid "API key"
msgstr "API-kulcs"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Tárolt API-kulcs törlése"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"A kulcs titkosítva van tárolva. Hagyja üresen a megtartáshoz, vagy adjon "
"meg egy új kulcsot a cseréhez. A tárolt érték nem tekinthető meg."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Egyszer megadva, titkosítva tárolva, később nem tekinthető meg. Hagyja "
"üresen az OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] használatához."

#: admin.py:216
msgid "API key status"
msgstr "API-kulcs állapota"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Tárolva (titkosítva, nem látható)"

#: admin.py:220
msgid "Not set"
msgstr "Nincs beállítva"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "A tartalékmodellnek aktívnak kell lennie."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "A láncban szereplő modelleknek aktívnak kell lenniük."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "Az only_free_models csak ingyenes modelleket engedélyez."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Minden modell csak egyszer szerepelhet."

#: admin.py:293
msgid "Model"
msgstr "Modell"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modellek (prioritási sorrendben)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Használati profil"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Katalógus szinkronizálása az OpenRouterrel"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Szinkronizálás kész: %(created)s létrehozva, %(updated)s frissítve, "
"%(deactivated)s deaktiválva (%(total)s távoli)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Hozzárendelés használati profilhoz…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Modellek hozzárendelése használati profilhoz"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s már szerepel a láncban"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s inaktív"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s nem ingyenes (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "%(count)s modell hozzáadva a „%(profile)s” profilhoz."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Nem lett modell hozzáadva a „%(profile)s” profilhoz."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Kihagyva: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Nincs megadva használati profil, és a default_profile nincs beállítva."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "A(z) %(name)r használati profil nem található vagy inaktív."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Ismeretlen modell: %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "A(z) %(name)r profilhoz nincsenek modellek beállítva."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "A(z) %(name)r profilhoz nem maradt engedélyezett modell."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "A streamelés nincs implementálva a django-openrouter MVP-ben."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "Az OpenRouter le van tiltva az admin beállításaiban."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Az OpenRouter API-kulcs nincs beállítva."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Minden modell meghibásodott konkrét hiba nélkül."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "Az OpenRouter HTTP %(status)s hibát adott: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"A ClickHouseBackend „URL” kulcsot igényel a LOG_BACKENDS bejegyzésben "
"(pl. http://localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: érvénytelen %(label)s azonosító: %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "A LOG_BACKENDS bejegyzés dict „BACKEND” kulcsot igényel."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "A LOG_BACKENDS bejegyzések csak stringek vagy dictek lehetnek, kapott: %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "A(z) %(path)r naplóbackend nem importálható: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "A(z) %(path)r nem LogBackend alosztály."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "Az OPENROUTER['LOG_BACKENDS'] értékének listának kell lennie."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "A GET /api/v1/models lekérése és a helyi OpenRouter-katalógus upsertje."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "API-kulcs felülbírálása ehhez a futtatáshoz."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"

#: models.py:45
msgid "OpenRouter model id, e.g. anthropic/claude-3.5-sonnet"
msgstr "OpenRouter-modellazonosító, pl. anthropic/claude-3.5-sonnet"

#: models.py:52
msgid "Per-token prices: prompt, completion, optional request/image."
msgstr "Tokenenkénti árak: prompt, completion, opcionálisan request/image."

#: models.py:61
msgid "Prompt price per token from the catalog, for admin sorting."
msgstr "Prompt tokenenkénti ára a katalógusból, admin rendezéshez."

#: models.py:68
msgid "Completion price per token from the catalog, for admin sorting."
msgstr "Completion tokenenkénti ára a katalógusból, admin rendezéshez."

#: models.py:73
msgid "p50 TTFT for the best endpoint, in milliseconds."
msgstr "p50 TTFT a legjobb endpointnál, milliszekundumban."

#: models.py:78
msgid "p50 throughput (tok/s) for the best endpoint — load."
msgstr "p50 áteresztőképesség (tok/s) a legjobb endpointnál — terhelés."

