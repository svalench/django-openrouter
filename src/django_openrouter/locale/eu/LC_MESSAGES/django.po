msgstr "Kateko lehen modeloa (zerrendatik sinkronizatuta)."

#: models.py:142
msgid "If enabled, only models with zero catalog price may be used."
msgstr ""
"Gaituta badago, katalogo-prezio zeroa duten modeloak soilik erabili "
"daitezke."

#: models.py:149
msgid "Usage profiles"
msgstr "Erabilera-profilak"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Tenperaturak 0 eta 2 artean egon behar du."

#: models.py:163
msgid "Primary model must be active."
msgstr "Lehen mailako modeloa aktibo egon behar da."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "only_free_models-ek doako lehen mailako modeloa behar du."

#: models.py:263
msgid "Profile model"
msgstr "Profil-modeloa"

#: models.py:264
msgid "Profile models"
msgstr "Profil-modeloak"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models-ek doako ordezko modeloak soilik onartzen ditu."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Utzi hutsik OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] erabiltzeko."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "HTTP denbora-muga segundotan."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr ""
"Saiakerak modelo bakoitzeko garraio / 5xx erroreetan, ordezkorako."

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr ""
"Etengailu orokorra. Itzalita dagoenean, chat() dei bakoitzak huts egiten du."

