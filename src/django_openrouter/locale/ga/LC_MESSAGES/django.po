msgstr "Sáraíodh an buiséad laethúil (%(budget)s USD) don phróifíl %(name)r."

#: rules.py:61
#, python-format
msgid "Monthly budget (%(budget)s USD) exceeded for profile %(name)r."
msgstr "Sáraíodh an buiséad míosúil (%(budget)s USD) don phróifíl %(name)r."

#: rules.py:69
#, python-format
