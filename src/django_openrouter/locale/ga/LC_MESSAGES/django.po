msgstr "Slug cobhsaí a úsáidtear sa chód, m.sh. chat, translation."

#: models.py:116
msgid "First model in the chain (synced from the list)."
msgstr "An chéad tsámhail sa tslabhra (sioncrónaithe ón liosta)."

#: models.py:142
msgid "If enabled, only models with zero catalog price may be used."
msgstr "Má tá sé cumasaithe, ní féidir ach samhlacha le praghas nialais sa chatalóg a úsáid."

#: models.py:149
msgid "Usage profiles"
msgstr "Próifílí úsáide"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Caithfidh an teocht a bheith idir 0 agus 2."

#: models.py:163
msgid "Primary model must be active."
msgstr "Caithfidh an phríomhsámhail a bheith gníomhach."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "Teastaíonn príomhsámhail saor in aisce ó only_free_models."

#: models.py:263
msgid "Profile model"
msgstr "Sámhail phróifíle"

#: models.py:264
msgid "Profile models"
msgstr "Samhlacha próifíle"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "Ní ligeann only_free_models ach samhlacha leithscorachta saor in aisce."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr "Fágtar bán chun OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] a úsáid."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "Am eisiúna HTTP i soicindí."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr "Athdhéantar in aghaidh na samhla ar earráidí iompair / 5xx roimh leithscoracht."

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr "Cosc domhanda. Nuair atá sé as, teipeann ar ghlao chat() gach uair."

#: models.py:312 models.py:313 models.py:316
msgid "OpenRouter settings"
msgstr "Socruithe OpenRouter"

#: models.py:360
msgid "Request log"
msgstr "Loga iarratas"

#: models.py:361
