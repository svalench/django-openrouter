msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Стрымінг не рэалізаваны ў django-openrouter MVP."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter адключаны ў наладах адмінкі."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Ключ API OpenRouter не наладжаны."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Усе мадэлі адмовілі без канкрэтнай памылкі."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter вярнуў HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend патрабуе ключ 'URL' у запісе LOG_BACKENDS (напр. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: няправільны ідэнтыфікатар %(label)s %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Слоўнік запісу LOG_BACKENDS патрабуе ключа 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"Запісы LOG_BACKENDS павінны быць радкамі або слоўнікамі, атрымана %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Немагчыма імпартаваць бэкенд журнала %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r не з'яўляецца падклаcам LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] павінен быць спісам."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Атрымаць GET /api/v1/models і абнавіць лакальны каталог OpenRouter."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Перавызначыць ключ API для гэтага запуску."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"створана=%(created)s абноўлена=%(updated)s дэактывавана=%(deactivated)s "
"аддаленых=%(total)s"

