msgid "No usage profile specified and default_profile is not set."
msgstr "Профіль выкарыстання не пазначаны, а default_profile не зададзены."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Профіль выкарыстання %(name)r не знойдзены або неактыўны."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Невядомая мадэль %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "У профілі %(name)r не наладжана мадэляў."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Не засталося дазволеных мадэляў для профілю %(name)r."

