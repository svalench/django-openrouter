#: admin.py:78 admin.py:429
msgid "Price"
msgstr "Цана"

#: admin.py:85
msgid "Free"
msgstr "Бясплатныя"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Танныя (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Сярэднія ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Дарагія (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Хуткасць"

