#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Дададзена %(count)s мадэляў да профілю «%(profile)s»."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Ніводная мадэль не дададзена да профілю «%(profile)s»."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Прапушчана: %(reasons)s."

