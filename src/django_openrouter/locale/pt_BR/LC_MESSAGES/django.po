#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend requer 'URL' na entrada de LOG_BACKENDS (ex.: http://"
"localhost:8123)."

