msgstr "Streaming is nie in django-openrouter-MVP geïmplementeer nie."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter is gedeaktiveer in admin-instellings."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "OpenRouter-API-sleutel is nie opgestel nie."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Alle modelle het gefaal sonder 'n spesifieke fout."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter het HTTP %(status)s teruggestuur: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend vereis 'URL' in die LOG_BACKENDS-inskrywing (bv. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: ongeldige %(label)s-identifiseerder %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "LOG_BACKENDS-inskrywing-dict vereis 'n 'BACKEND'-sleutel."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "LOG_BACKENDS-inskrywings moet stringe of dikte wees; %(type)s ontvang."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Kan log-backend %(path)r nie invoer nie: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r is nie 'n LogBackend-subklas nie."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] moet 'n lys wees."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Haal GET /api/v1/models op en upsert die plaaslike OpenRouter-katalogus."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Oorskryf API-sleutel vir hierdie loping."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"geskep=%(created)s bygewerk=%(updated)s gedeaktiveer=%(deactivated)s "
"afstand=%(total)s"

