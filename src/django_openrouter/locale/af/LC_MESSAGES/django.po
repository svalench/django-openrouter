msgid "Sync catalog with OpenRouter"
msgstr "Sinkroniseer katalogus met OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Sinkronisasie voltooi: %(created)s geskep, %(updated)s bygewerk, "
"%(deactivated)s gedeaktiveer (%(total)s afstand)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Ken toe aan gebruiksprofiel…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Ken modelle aan gebruiksprofiel toe"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s reeds in die ketting"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s onaktief"

#: admin.py:536
#, python-format
