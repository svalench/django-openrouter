#: admin.py:136
msgid "API key"
msgstr "API-sleutel"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Verwyder gestoorde API-sleutel"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"'n Sleutel word geënkripteer gestoor. Laat leeg om dit te hou, of voer 'n "
"nuwe sleutel in om dit te vervang. Die gestoorde waarde kan nie bekyk word "
"nie."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Word een maal ingevoer, geënkripteer gestoor en kan nie weer bekyk word nie. "
"Laat leeg om OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] te gebruik."

#: admin.py:216
msgid "API key status"
msgstr "API-sleutelstatus"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Gestoor (geënkripteer, nie sigbaar nie)"

#: admin.py:220
msgid "Not set"
msgstr "Nie gestel nie"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Terugvalmodel moet aktief wees."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Modelle in die ketting moet aktief wees."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models laat slegs gratis modelle toe."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Elke model mag slegs een maal voorkom."

#: admin.py:293
