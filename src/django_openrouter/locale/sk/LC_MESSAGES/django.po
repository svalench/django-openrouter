#: admin.py:136
msgid "API key"
msgstr "API kľúč"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Vymazať uložený API kľúč"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Kľúč je uložený šifrovane. Ak ho chcete zachovať, pole nechajte prázdne, "
"alebo zadajte nový kľúč na jeho nahradenie. Uloženú hodnotu nie je možné "
"zobraziť."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Zadá sa raz, uloží sa šifrovane a už ho nie je možné znova zobraziť. Ak "
"chcete použiť OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'], "
"nechajte prázdne."

#: admin.py:216
msgid "API key status"
msgstr "Stav API kľúča"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Uložený (šifrovane, nie je viditeľný)"

#: admin.py:220
msgid "Not set"
msgstr "Nenastavený"

