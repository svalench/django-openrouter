#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Synchronizácia dokončená: %(created)s vytvorených, %(updated)s "
"aktualizovaných, %(deactivated)s deaktivovaných (%(total)s vzdialených)."

