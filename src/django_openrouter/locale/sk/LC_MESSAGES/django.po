msgid "Models in the chain must be active."
msgstr "Modely v reťazci musia byť aktívne."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models povoľuje iba bezplatné modely."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Každý model sa môže vyskytnúť iba raz."

