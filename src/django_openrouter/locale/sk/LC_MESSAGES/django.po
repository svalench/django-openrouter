msgstr "Stredné (1–10 USD / 1 mil.)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Drahé (≥ 10 USD / 1 mil.)"

#: admin.py:98
msgid "Speed"
msgstr "Rýchlosť"

