#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Lichy (< 1 $ / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Srěźny (1–10 $ / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Drogi (≥ 10 $ / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Malsnosć"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Malsny (< 400 ms)"

