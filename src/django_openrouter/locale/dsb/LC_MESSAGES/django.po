msgstr "Njeznate zakasnjenje"

#: admin.py:136
msgid "API key"
msgstr "API-kluc"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Skłaźony API-kluc wótwónoźeś"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Kluc se skłaźujo skoděrowany. Póstaj prozne, aby jen wobchował, abo zapódaj "
"nowy kluc, aby jen wuměnił. Skłaźona gódnota se njedajo pokazaś."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Jadenkrat zapódany, skoděrowany skłaźony a zasej njepokazujobny. Póstaj "
"prozne, aby OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] se wužywał."

#: admin.py:216
msgid "API key status"
msgstr "Status API-kluca"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Skłaźony (skoděrowany, njejo widobny)"

#: admin.py:220
msgid "Not set"
msgstr "Njenastajony"

#: admin.py:250 models.py:274
msgid "Fallback model must be active."
msgstr "Fallback-model musy aktiwny byś."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Modele w rězawju muse aktiwne byś."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "only_free_models dowólujo jano darmowe modele."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Kuždy model smějo se jano jadenkrat jewiś."

#: admin.py:293
msgid "Model"
msgstr "Model"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modele (pórěd pó prioriśe)"

#: admin.py:324 models.py:148
msgid "Usage profile"
msgstr "Profil wužywanja"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Katalog z OpenRouter synchronizěrowaś"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Synchronizacija dokóńcona: %(created)s załožonych, %(updated)s "
"aktualizěrowanych, %(deactivated)s deaktiwěrowanych (%(total)s zdalonych)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Profiloju wužywanja pśipokazaś…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Modele profiloju wužywanja pśipokazaś"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s južo w rězawju"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s njeaktiwne"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s njedarmowe (only_free_models)"

