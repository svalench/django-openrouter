#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Profil wužywanja %(name)r njejo namakany abo njejo aktiwny."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Njeznaty model %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Profil %(name)r njama žedne modele skonfigurěrowane."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Za profil %(name)r wěcej dowólonych modelow njejo."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Streaming njejo w django-openrouter MVP implementěrowany."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "OpenRouter jo w administratowskich nastajenjach znjemóžnjony."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "API-kluc OpenRouter njejo skonfigurěrowany."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Wšykne modele su se njeraźili bźez wěsteje zmólki."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "OpenRouter jo HTTP %(status)s wrośił: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"ClickHouseBackend trjebajo 'URL' w zapisku LOG_BACKENDS (na pś. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: njepłaśiwy identifikator %(label)s %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Słownik zapiska LOG_BACKENDS trjebajo kluc 'BACKEND'."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr ""
"Zapiski LOG_BACKENDS muse znamuškowe rěcy abo słowniki byś, dosto %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Protokolowański backend %(path)r njedajo se importěrowaś: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "%(path)r njejo pódklasa LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "OPENROUTER['LOG_BACKENDS'] musy lisćina byś."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr ""
"GET /api/v1/models wótwołaś a lokalny katalog OpenRouter aktualizěrowaś."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "API-kluc za toś ten wuwjeźenje pśepisaś."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"załožene=%(created)s aktualizěrowane=%(updated)s deaktiwěrowane="
"%(deactivated)s zdalene=%(total)s"

#: models.py:45
