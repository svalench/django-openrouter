#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Žedne modele njejsu se profiloju „%(profile)s“ pśidali."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Pśeskócane: %(reasons)s."

