msgstr "only_free_models-ന് സൗജന്യ പ്രാഥമിക മോഡൽ ആവശ്യമാണ്."

#: models.py:263
msgid "Profile model"
msgstr "പ്രൊഫൈൽ മോഡൽ"

#: models.py:264
msgid "Profile models"
msgstr "പ്രൊഫൈൽ മോഡലുകൾ"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "only_free_models സൗജന്യ ഫോൾബാക്ക് മോഡലുകൾ മാത്രമേ അനുവദിക്കൂ."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY'] ഉപയോഗിക്കാൻ ശൂന്യമായി വിടുക."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "സെക്കൻഡുകളിലുള്ള HTTP ടൈംഔട്ട്."

#: models.py:304
