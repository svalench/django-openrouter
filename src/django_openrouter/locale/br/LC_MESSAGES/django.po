msgid "OpenRouter models"
msgstr "Modelloù OpenRouter"

#: models.py:108
msgid "Stable slug used in code, e.g. chat, translation."
msgstr "Slug stabil implijet er c'hod, da skouer chat, translation."

#: models.py:116
msgid "First model in the chain (synced from the list)."
msgstr "Kentañ model er chadenn (sinkronel eus al listenn)."

#: models.py:142
msgid "If enabled, only models with zero catalog price may be used."
msgstr ""
"M'eo gweredekaet, n'eus nemet ar modelloù gant priz katalog mann a c'hall "
"bezañ implijet."

#: models.py:149
msgid "Usage profiles"
msgstr "Profiloù implij"

#: models.py:157
msgid "Temperature must be between 0 and 2."
msgstr "Rankout a ra an temperadur bezañ etre 0 ha 2."

#: models.py:163
msgid "Primary model must be active."
msgstr "Rankout a ra ar model pennañ bezañ oberiant."

#: models.py:166
msgid "only_free_models requires a free primary model."
msgstr "Ezhomm a ra only_free_models eus ur model pennañ digoust."

#: models.py:263
msgid "Profile model"
msgstr "Model profil"

#: models.py:264
msgid "Profile models"
msgstr "Modelloù profil"

#: models.py:277
msgid "only_free_models allows only free fallback models."
msgstr "Ne aotren only_free_models nemet ar modelloù fallback digoust."

#: models.py:287
msgid "Leave empty to use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Lezit goullo evit implijout OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: models.py:300
msgid "HTTP timeout in seconds."
msgstr "Dale HTTP e eilennoù."

#: models.py:304
msgid "Retries per model on transport / 5xx errors before fallback."
msgstr ""
"Adklaskoù dre model war fazioù treuzkas / 5xx a-raok ar fallback."

#: models.py:308
msgid "Global kill switch. When off, every chat() call fails."
msgstr ""
"Chankedra kill hollek. Pa vez lazhet, c'hwitañ a ra pep galv chat()."

#: models.py:312 models.py:313 models.py:316
msgid "OpenRouter settings"
msgstr "Stummoù OpenRouter"

#: models.py:360
msgid "Request log"
msgstr "Kazetenn ar goulennoù"

#: models.py:361
