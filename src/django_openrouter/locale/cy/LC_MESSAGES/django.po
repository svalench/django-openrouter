msgstr "Oediad anhysbys"

#: admin.py:136
msgid "API key"
msgstr "Allwedd API"

#: admin.py:145
msgid "Clear stored API key"
msgstr "Clirio'r allwedd API sydd wedi'i storio"

#: admin.py:168
msgid ""
"A key is stored encrypted. Leave blank to keep it, or enter a new key to "
"replace it. The stored value cannot be viewed."
msgstr ""
"Mae allwedd wedi'i storio wedi'i hamgryptio. Gadewch yn wag i'w chadw, neu "
"nodwch allwedd newydd i'w disodli. Ni ellir gweld y gwerth sydd wedi'i storio."

#: admin.py:173
msgid ""
"Entered once, stored encrypted, and cannot be viewed again. Leave empty to "
"use OPENROUTER_API_KEY / settings.OPENROUTER['API_KEY']."
msgstr ""
"Caiff ei nodi unwaith, ei storio wedi'i hamgryptio, ac ni ellir ei gweld "
"eto. Gadewch yn wag i ddefnyddio OPENROUTER_API_KEY / "
"settings.OPENROUTER['API_KEY']."

#: admin.py:216
msgid "API key status"
msgstr "Statws allwedd API"

#: admin.py:219
msgid "Stored (encrypted, not visible)"
msgstr "Wedi'i storio (wedi'i hamgryptio, heb ei weld)"

#: admin.py:220
msgid "Not set"
msgstr "Heb ei osod"

