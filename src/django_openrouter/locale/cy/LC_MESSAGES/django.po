msgid "Usage profile"
msgstr "Proffil defnydd"

#: admin.py:436
msgid "Sync catalog with OpenRouter"
msgstr "Cysoni'r catalog ag OpenRouter"

#: admin.py:450
#, python-format
msgid ""
"Sync complete: %(created)s created, %(updated)s updated, %(deactivated)s "
"deactivated (%(total)s remote)."
msgstr ""
"Cysoni wedi gorffen: %(created)s wedi'u creu, %(updated)s wedi'u "
"diweddaru, %(deactivated)s wedi'u diactifadu (%(total)s o bell)."

#: admin.py:461
msgid "Assign to usage profile…"
msgstr "Neilltuo i broffil defnydd…"

#: admin.py:481
msgid "Assign models to usage profile"
msgstr "Neilltuo modelau i broffil defnydd"

#: admin.py:534
#, python-format
msgid "%(count)s already in the chain"
msgstr "%(count)s eisoes yn y gadwyn"

#: admin.py:535
#, python-format
msgid "%(count)s inactive"
msgstr "%(count)s anweithredol"

#: admin.py:536
#, python-format
msgid "%(count)s not free (only_free_models)"
msgstr "%(count)s ddim am ddim (only_free_models)"

#: admin.py:542
#, python-format
msgid "Added %(count)s model(s) to profile “%(profile)s”."
msgstr "Ychwanegwyd %(count)s model(i) at y proffil “%(profile)s”."

#: admin.py:548
#, python-format
msgid "No models were added to profile “%(profile)s”."
msgstr "Ni ychwanegwyd unrhyw fodelau at y proffil “%(profile)s”."

#: admin.py:551
#, python-format
msgid "Skipped: %(reasons)s."
msgstr "Wedi'u hepgor: %(reasons)s."

#: client.py:131
msgid "No usage profile specified and default_profile is not set."
msgstr "Dim proffil defnydd wedi'i nodi ac mae default_profile heb ei osod."

#: client.py:135
#, python-format
msgid "Usage profile %(name)r is not found or inactive."
msgstr "Proffil defnydd %(name)r heb ei ganfod neu'n anweithredol."

#: client.py:151
#, python-format
msgid "Unknown model %(model_id)r."
msgstr "Model anhysbys %(model_id)r."

#: client.py:167
#, python-format
msgid "Profile %(name)r has no models configured."
msgstr "Proffil %(name)r heb unrhyw fodelau wedi'u ffurfweddu."

#: client.py:171
#, python-format
msgid "No allowed models left for profile %(name)r."
msgstr "Dim modelau caniatebol ar ôl ar gyfer y proffil %(name)r."

#: client.py:237
msgid "Streaming is not implemented in django-openrouter MVP."
msgstr "Nid yw ffrydio wedi'i weithredu yn MVP django-openrouter."

#: client.py:240
msgid "OpenRouter is disabled in admin settings."
msgstr "Mae OpenRouter wedi'i analluogi yng ngosodiadau'r gweinydd."

#: client.py:242 sync.py:213
msgid "OpenRouter API key is not configured."
msgstr "Nid yw allwedd API OpenRouter wedi'i ffurfweddu."

#: client.py:268 client.py:358
msgid "All models failed without a specific error."
msgstr "Methodd pob model heb wall penodol."

#: client.py:321 client.py:436
#, python-format
msgid "OpenRouter returned HTTP %(status)s: %(error)s"
msgstr "Dychwelodd OpenRouter HTTP %(status)s: %(error)s"

#: log_backends.py:194
msgid ""
"ClickHouseBackend requires 'URL' in the LOG_BACKENDS entry (e.g. http://"
"localhost:8123)."
msgstr ""
"Mae angen 'URL' ar ClickHouseBackend yn y cofnod LOG_BACKENDS (e.e. http://"
"localhost:8123)."

#: log_backends.py:204
#, python-format
msgid "ClickHouseBackend: invalid %(label)s identifier %(identifier)r."
msgstr "ClickHouseBackend: %(label)s nod annilys %(identifier)r."

#: log_backends.py:245
msgid "LOG_BACKENDS entry dict requires a 'BACKEND' key."
msgstr "Mae angen allwedd 'BACKEND' ar gofnod dict LOG_BACKENDS."

#: log_backends.py:250
#, python-format
msgid "LOG_BACKENDS entries must be strings or dicts, got %(type)s."
msgstr "Rhaid i gofnodion LOG_BACKENDS fod yn llinynnau neu dicts, cafwyd %(type)s."

#: log_backends.py:257
#, python-format
msgid "Cannot import log backend %(path)r: %(error)s"
msgstr "Methu mewnforio backend log %(path)r: %(error)s"

#: log_backends.py:260
#, python-format
msgid "%(path)r is not a LogBackend subclass."
msgstr "Nid yw %(path)r yn is-ddosbarth LogBackend."

#: log_backends.py:276
msgid "OPENROUTER['LOG_BACKENDS'] must be a list."
msgstr "Rhaid i OPENROUTER['LOG_BACKENDS'] fod yn restr."

#: management/commands/sync_models.py:11
msgid "Fetch GET /api/v1/models and upsert the local OpenRouter catalog."
msgstr "Nôl GET /api/v1/models ac upsert y catalog OpenRouter lleol."

#: management/commands/sync_models.py:18
msgid "Override API key for this run."
msgstr "Anwybyddu'r allwedd API ar gyfer y rhediad hwn."

#: management/commands/sync_models.py:31
#, python-format
msgid ""
"created=%(created)s updated=%(updated)s deactivated=%(deactivated)s "
"remote=%(total)s"
msgstr ""
"crëwyd=%(created)s diweddarwyd=%(updated)s diactifadwyd=%(deactivated)s "
"pell=%(total)s"

