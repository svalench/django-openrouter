msgid "Free"
msgstr "Am ddim"

#: admin.py:86
msgid "Cheap (< $1 / 1M)"
msgstr "Rhad (< $1 / 1M)"

#: admin.py:87
msgid "Mid ($1-$10 / 1M)"
msgstr "Canolig ($1-$10 / 1M)"

#: admin.py:88
msgid "Expensive (>= $10 / 1M)"
msgstr "Drud (>= $10 / 1M)"

#: admin.py:98
msgid "Speed"
msgstr "Cyflymder"

#: admin.py:105
msgid "Fast (< 400 ms)"
msgstr "Cyflym (< 400 ms)"

