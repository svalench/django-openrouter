msgid "Fallback model must be active."
msgstr "Rhaid i'r model wrth gefn fod yn weithredol."

#: admin.py:269
msgid "Models in the chain must be active."
msgstr "Rhaid i'r modelau yn y gadwyn fod yn weithredol."

#: admin.py:271
msgid "only_free_models allows only free models."
msgstr "mae only_free_models yn caniatáu dim ond modelau am ddim."

#: admin.py:273
msgid "Each model may appear only once."
msgstr "Dim ond unwaith y caiff model ymddangos."

#: admin.py:293
msgid "Model"
msgstr "Model"

#: admin.py:294
msgid "Models (priority order)"
msgstr "Modelau (trefn blaenoriaeth)"

